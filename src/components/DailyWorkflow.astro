---
const steps = [
  {
    number: '01',
    time: '08:30',
    title: 'Entra el aviso',
    text: 'Ubicación, prioridad, descripción y fotografías desde el primer momento.',
    type: 'ui',
    image: ''
  },
  {
    number: '02',
    time: '08:35',
    title: 'Se coordina el trabajo',
    text: 'Técnico, carga del equipo, especialidad y materiales antes de desplazarse.',
    type: 'photo',
    image: 'https://images.pexels.com/photos/32845695/pexels-photo-32845695.jpeg?auto=compress&cs=tinysrgb&w=760'
  },
  {
    number: '03',
    time: '09:05',
    title: 'Se consulta el activo',
    text: 'Código, historial, ubicación, documentos y preventivos desde QR o NFC.',
    type: 'qr',
    image: ''
  },
  {
    number: '04',
    time: '09:15',
    title: 'Se realiza la intervención',
    text: 'Trabajo, mediciones, material utilizado y observaciones desde campo.',
    type: 'photo',
    image: 'https://images.pexels.com/photos/33694019/pexels-photo-33694019.jpeg?auto=compress&cs=tinysrgb&w=760'
  },
  {
    number: '05',
    time: '10:05',
    title: 'Se documenta y se cierra',
    text: 'Fotografías, checklist, firma, informe e histórico para la siguiente actuación.',
    type: 'photo',
    image: 'https://images.pexels.com/photos/32845694/pexels-photo-32845694.jpeg?auto=compress&cs=tinysrgb&w=760'
  }
];
---

<section class="daily-workflow" aria-labelledby="daily-workflow-title" data-daily-workflow>
  <div class="container">
    <div class="daily-workflow-heading reveal">
      <div>
        <p class="eyebrow">Una jornada conectada</p>
        <h2 id="daily-workflow-title">Así se mueve una OT durante la mañana</h2>
      </div>
      <p class="lead">El aviso no desaparece al asignarlo. Su contexto acompaña al equipo, al activo, a la intervención y al informe final.</p>
    </div>

    <div class="daily-workflow-track" data-daily-track>
      <span class="daily-track-progress" data-daily-progress aria-hidden="true"></span>
      {steps.map((step, index) => (
        <article
          class:list={["daily-step", index === 0 && "is-active"]}
          data-daily-step={index}
          tabindex="0"
          aria-current={index === 0 ? 'step' : undefined}
        >
          <header>
            <span>{step.number}</span>
            <time>{step.time}</time>
          </header>

          <div class:list={["daily-step-media", `daily-step-${step.type}`]}>
            {step.type === 'photo' && (
              <img src={step.image} alt="" width="760" height="520" loading="lazy" decoding="async" />
            )}

            {step.type === 'ui' && (
              <div class="daily-alert-ui" aria-hidden="true">
                <div><i></i><strong>Nuevo aviso</strong><span>08:30</span></div>
                <b>Fallo de iluminación</b>
                <p>Planta 2 · Pasillo quirófanos</p>
                <footer><span>Prioridad alta</span><em>2 fotografías</em></footer>
              </div>
            )}

            {step.type === 'qr' && (
              <div class="daily-asset-ui" aria-hidden="true">
                <div class="daily-qr"></div>
                <div><small>Activo identificado</small><strong>CL-02</strong><span>Cuadro iluminación QF-2</span><em>3 actuaciones anteriores</em></div>
              </div>
            )}
          </div>

          <div class="daily-step-copy">
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  document.querySelectorAll('[data-daily-workflow]').forEach((section) => {
    const steps = [...section.querySelectorAll('[data-daily-step]')];
    const track = section.querySelector('[data-daily-track]');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const mobile = window.matchMedia('(max-width: 760px)').matches;
    const scheduled = [];
    let currentIndex = 0;
    let hasPlayed = false;
    let userInteracted = false;

    const activate = (index, { scroll = false } = {}) => {
      currentIndex = Math.max(0, Math.min(index, steps.length - 1));
      steps.forEach((step, stepIndex) => {
        const active = stepIndex === currentIndex;
        step.classList.toggle('is-active', active);
        step.classList.toggle('is-past', stepIndex < currentIndex);
        if (active) step.setAttribute('aria-current', 'step');
        else step.removeAttribute('aria-current');
      });
      const progress = steps.length > 1 ? (currentIndex / (steps.length - 1)) * 91.6 : 0;
      track?.style.setProperty('--daily-progress', `${progress}%`);
      if (scroll && mobile && !userInteracted) {
        steps[currentIndex]?.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'nearest', inline: 'center' });
      }
    };

    const cancelSequence = () => {
      userInteracted = true;
      scheduled.splice(0).forEach((timer) => window.clearTimeout(timer));
    };

    if (reduceMotion) {
      steps.forEach((step) => step.classList.add('is-past'));
      track?.style.setProperty('--daily-progress', '91.6%');
      return;
    }

    const playSequence = () => {
      if (hasPlayed) return;
      hasPlayed = true;
      steps.forEach((_, index) => {
        scheduled.push(window.setTimeout(() => activate(index, { scroll: true }), index * 1050));
      });
    };

    const sectionObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) playSequence();
      });
    }, { threshold: mobile ? .34 : .48 });
    sectionObserver.observe(section);

    steps.forEach((step, index) => {
      step.addEventListener('mouseenter', () => activate(index));
      step.addEventListener('focus', () => activate(index));
      step.addEventListener('click', () => activate(index));
    });

    if (mobile && track) {
      const cardObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting && userInteracted) {
            activate(Number(entry.target.getAttribute('data-daily-step')));
          }
        });
      }, { root: track, threshold: .68 });
      steps.forEach((step) => cardObserver.observe(step));

      track.addEventListener('pointerdown', cancelSequence, { passive: true });
      track.addEventListener('touchstart', cancelSequence, { passive: true });
      track.addEventListener('wheel', cancelSequence, { passive: true });
    }
  });
</script>
