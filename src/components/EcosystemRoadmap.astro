---
interface Props {
  compact?: boolean;
  title?: string;
}

const {
  compact = false,
  title = 'Un ecosistema que crece pieza a pieza'
} = Astro.props;

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const withBase = (href: string) => href === '/' ? base : `${base}${href.replace(/^\/+/, '')}`;

const laterModules = [
  ['BT', 'Inspecciones'],
  ['QR', 'Activos'],
  ['AL', 'Inventario'],
  ['RT', 'RITE'],
  ['PCI', 'PCI'],
  ['H₂O', 'Legionella'],
  ['DOC', 'Documentación'],
  ['AI', 'Utilidades']
];
---

<section class:list={['eco-roadmap', compact && 'is-compact']} aria-labelledby="eco-roadmap-title">
  <div class="eco-roadmap-heading" data-premium-reveal>
    <p class="eyebrow">Hoja de ruta IsiVoltPro</p>
    <h2 id="eco-roadmap-title">{title}</h2>
    <p>Herramientas QR/NFC e IsiVoltPro OT ya están operativas. La siguiente evolución conectará inspecciones, activos, inventario y nuevas especialidades técnicas.</p>
  </div>

  <div class="eco-roadmap-track" data-premium-reveal>
    <a class="eco-roadmap-stage is-live" href={withBase('/aplicaciones/herramientas-maletines')}>
      <span class="eco-roadmap-order">01</span>
      <div class="eco-roadmap-symbol">▦</div>
      <div><small>Operativa</small><strong>Herramientas QR/NFC</strong><p>Inventario, técnicos, préstamos, devoluciones, QR, NFC e historial.</p></div>
      <b>Disponible</b>
    </a>

    <span class="eco-roadmap-arrow" aria-hidden="true">→</span>

    <a class="eco-roadmap-stage is-live is-ot" href={withBase('/aplicaciones/mantenimiento-ot')}>
      <span class="eco-roadmap-order">02</span>
      <div class="eco-roadmap-symbol">OT</div>
      <div><small>Operativa</small><strong>IsiVoltPro OT</strong><p>Avisos, órdenes, instalaciones, técnicos, evidencias, checklist e informes.</p></div>
      <b>Disponible</b>
    </a>

    <span class="eco-roadmap-arrow" aria-hidden="true">→</span>

    <div class="eco-roadmap-stage is-future">
      <span class="eco-roadmap-order">03+</span>
      <div class="eco-roadmap-symbol">+</div>
      <div><small>Siguiente evolución</small><strong>Especialidades conectadas</strong><p>Cada aplicación podrá funcionar por separado y compartir contexto cuando aporte valor.</p></div>
      <b>Roadmap</b>
    </div>
  </div>

  <div class="eco-roadmap-modules" aria-label="Módulos posteriores del ecosistema">
    {laterModules.map(([code, name], index) => (
      <span data-premium-reveal style={`transition-delay:${index * 35}ms`}><b>{code}</b>{name}</span>
    ))}
  </div>
</section>

<style>
  .eco-roadmap{padding:clamp(4.4rem,8vw,7rem) 0}.eco-roadmap.is-compact{padding:2rem 0 0}.eco-roadmap-heading{max-width:820px;margin:0 auto 2.3rem;text-align:center}.eco-roadmap-heading h2{font-size:clamp(2rem,4vw,3.45rem)}.eco-roadmap-heading p:last-child{max-width:760px;margin:0 auto;color:var(--ink-soft)}.eco-roadmap-track{display:grid;grid-template-columns:minmax(0,1fr) auto minmax(0,1fr) auto minmax(0,1fr);align-items:stretch;gap:.85rem}.eco-roadmap-stage{position:relative;display:grid;grid-template-columns:auto 1fr;gap:1rem;min-height:235px;padding:1.45rem;border:1px solid #dde5ee;border-radius:24px;background:#fff;box-shadow:0 18px 46px rgba(11,35,65,.07);transition:transform .25s ease,border-color .25s ease,box-shadow .25s ease}.eco-roadmap-stage:hover{transform:translateY(-5px);box-shadow:0 24px 58px rgba(11,35,65,.12)}.eco-roadmap-stage.is-live{border-color:rgba(28,179,132,.38);background:linear-gradient(155deg,#fff,#f2fffa)}.eco-roadmap-stage.is-ot{border-color:rgba(20,102,239,.34);background:linear-gradient(155deg,#fff,#f2f7ff)}.eco-roadmap-stage.is-future{background:linear-gradient(155deg,#fff,#f5f8fc)}.eco-roadmap-order{position:absolute;top:1rem;right:1rem;color:#a5b1bf;font-size:.68rem;font-weight:900;letter-spacing:.08em}.eco-roadmap-symbol{display:grid;place-items:center;width:48px;height:48px;border-radius:15px;background:#071a33;color:#fff;font-size:1rem;font-weight:900}.is-live .eco-roadmap-symbol{background:#159c75}.is-ot .eco-roadmap-symbol{background:#1466ef}.eco-roadmap-stage small{display:block;margin:.15rem 0 .35rem;color:#718096;font-size:.68rem;font-weight:850;text-transform:uppercase;letter-spacing:.08em}.eco-roadmap-stage strong{display:block;font-size:1.18rem;line-height:1.2}.eco-roadmap-stage p{grid-column:1/-1;margin:.15rem 0 2.3rem;color:var(--ink-soft);font-size:.83rem;line-height:1.62}.eco-roadmap-stage>b{position:absolute;left:1.45rem;bottom:1.25rem;padding:.38rem .62rem;border-radius:999px;background:#eef3f8;color:#536275;font-size:.66rem}.is-live>b{background:#dff8ee;color:#087452}.is-ot>b{background:#e7f0ff;color:#145dc7}.eco-roadmap-arrow{display:grid;place-items:center;color:#aab6c4;font-size:1.35rem}.eco-roadmap-modules{display:grid;grid-template-columns:repeat(8,1fr);gap:.65rem;margin-top:1rem}.eco-roadmap-modules span{display:flex;align-items:center;justify-content:center;gap:.45rem;min-height:48px;padding:.6rem;border:1px solid #e2e8ef;border-radius:14px;background:#fff;color:#536275;font-size:.7rem;font-weight:750;text-align:center}.eco-roadmap-modules b{color:#ef2636;font-size:.66rem}.is-compact .eco-roadmap-heading{text-align:left;margin-inline:0}.is-compact .eco-roadmap-track{grid-template-columns:1fr}.is-compact .eco-roadmap-arrow{display:none}.is-compact .eco-roadmap-stage{min-height:0}.is-compact .eco-roadmap-modules{grid-template-columns:repeat(4,1fr)}
  @media(max-width:980px){.eco-roadmap-track{grid-template-columns:1fr}.eco-roadmap-arrow{transform:rotate(90deg);min-height:20px}.eco-roadmap-modules{grid-template-columns:repeat(4,1fr)}}
  @media(max-width:600px){.eco-roadmap{padding:3.8rem 0}.eco-roadmap-stage{min-height:0;padding:1.15rem;border-radius:19px}.eco-roadmap-stage p{margin-bottom:2.1rem}.eco-roadmap-modules,.is-compact .eco-roadmap-modules{grid-template-columns:repeat(2,1fr)}}
</style>