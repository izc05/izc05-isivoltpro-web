---
const videoUrl = 'https://videos.pexels.com/video-files/28886877/12504681_1920_1080_30fps.mp4';
const heroPoster = 'https://images.pexels.com/photos/32845694/pexels-photo-32845694.jpeg?auto=compress&cs=tinysrgb&w=1400';
const modalPoster = 'https://images.pexels.com/photos/33694019/pexels-photo-33694019.jpeg?auto=compress&cs=tinysrgb&w=1280';
---

<div class="real-hero-media reveal" data-real-hero-media aria-label="Trabajo técnico y orden de trabajo de IsiVoltPro">
  <figure class="real-hero-photo">
    <img
      src={heroPoster}
      alt="Técnico realizando una comprobación en una instalación eléctrica"
      width="1400"
      height="900"
      fetchpriority="high"
      decoding="async"
    />
    <video
      class="real-hero-loop"
      muted
      loop
      playsinline
      preload="none"
      poster={heroPoster}
      aria-hidden="true"
      data-hero-loop
    >
      <source data-src={videoUrl} type="video/mp4" />
    </video>
    <div class="real-hero-film" aria-hidden="true"></div>
    <figcaption>
      <span class="real-live-dot"></span>
      Intervención documentada desde campo
    </figcaption>
    <button class="hero-video-toggle" type="button" data-toggle-hero-video aria-label="Pausar vídeo del hero" aria-pressed="false" hidden>
      <span aria-hidden="true">Ⅱ</span>
    </button>
  </figure>

  <section class="real-operations-card" aria-label="Ejemplo conceptual de una orden de trabajo">
    <div class="real-operations-head">
      <div>
        <small>Orden en curso</small>
        <strong>OT-2026-0148</strong>
      </div>
      <span>Prioridad alta</span>
    </div>

    <p class="real-location">Planta 2 · Pasillo de quirófanos</p>

    <div class="real-work-detail">
      <div><small>Técnico</small><strong>Equipo eléctrico</strong></div>
      <div><small>Estado</small><strong class="status-running">En curso</strong></div>
      <div><small>Activo</small><strong>CL-02 · Cuadro iluminación</strong></div>
      <div><small>Inicio</small><strong>Hoy · 09:15</strong></div>
    </div>

    <div class="real-progress-row">
      <span>Intervención</span><b>60 %</b>
    </div>
    <div class="real-progress"><span></span></div>

    <div class="real-activity">
      <div><i></i><span>09:15</span><p>Trabajo iniciado desde el móvil</p></div>
      <div><i></i><span>09:24</span><p>Activo identificado y revisado</p></div>
    </div>
  </section>

  <button class="real-video-preview" type="button" data-open-video aria-haspopup="dialog">
    <span class="real-video-thumb">
      <img src={modalPoster} alt="" width="520" height="340" loading="lazy" decoding="async" />
      <i aria-hidden="true">▶</i>
    </span>
    <span><strong>Ver intervención real</strong><small>Vídeo corto · sin sonido</small></span>
  </button>
</div>

<dialog class="media-dialog" data-video-dialog aria-label="Vídeo de trabajo técnico">
  <button class="media-dialog-close" type="button" data-close-video aria-label="Cerrar vídeo">×</button>
  <div class="media-dialog-frame">
    <video controls playsinline preload="none" data-field-video poster={modalPoster}>
      <source data-src={videoUrl} type="video/mp4" />
      Tu navegador no puede reproducir este vídeo.
    </video>
    <div class="media-dialog-copy">
      <strong>Intervención técnica en un cuadro de control</strong>
      <span>Vídeo de apoyo para representar el trabajo diario. La interfaz mostrada corresponde a una demostración de IsiVoltPro.</span>
    </div>
  </div>
</dialog>

<script is:inline>
  const openButton = document.querySelector('[data-open-video]');
  const closeButton = document.querySelector('[data-close-video]');
  const dialog = document.querySelector('[data-video-dialog]');
  const fieldVideo = document.querySelector('[data-field-video]');
  const fieldSource = fieldVideo?.querySelector('source[data-src]');
  const mediaRoot = document.querySelector('[data-real-hero-media]');
  const heroLoop = mediaRoot?.querySelector('[data-hero-loop]');
  const heroSource = heroLoop?.querySelector('source[data-src]');
  const heroToggle = mediaRoot?.querySelector('[data-toggle-hero-video]');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const connection = navigator.connection || navigator.mozConnection || navigator.webkitConnection;
  const slowConnection = connection?.saveData || ['slow-2g', '2g'].includes(connection?.effectiveType || '');
  const canUseHeroVideo = !reduceMotion && !slowConnection && window.innerWidth >= 760;

  openButton?.addEventListener('click', () => {
    if (fieldSource && !fieldSource.getAttribute('src')) {
      fieldSource.setAttribute('src', fieldSource.dataset.src || '');
      fieldVideo?.load();
    }
    dialog?.showModal();
  });

  const closeVideo = () => {
    fieldVideo?.pause();
    dialog?.close();
  };

  closeButton?.addEventListener('click', closeVideo);
  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) closeVideo();
  });

  if (mediaRoot) {
    new IntersectionObserver((entries, observer) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-in-view');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: .3 }).observe(mediaRoot);
  }

  if (canUseHeroVideo && mediaRoot && heroLoop && heroSource) {
    let loaded = false;
    const heroObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          if (!loaded) {
            heroSource.setAttribute('src', heroSource.dataset.src || '');
            heroLoop.load();
            loaded = true;
          }
          heroLoop.play().catch(() => {});
        } else {
          heroLoop.pause();
        }
      });
    }, { threshold: .18 });

    heroObserver.observe(mediaRoot);

    heroLoop.addEventListener('canplay', () => {
      mediaRoot.classList.add('has-live-video');
      if (heroToggle) heroToggle.hidden = false;
    }, { once: true });

    heroToggle?.addEventListener('click', () => {
      const paused = heroLoop.paused;
      if (paused) {
        heroLoop.play().catch(() => {});
        heroToggle.setAttribute('aria-pressed', 'false');
        heroToggle.setAttribute('aria-label', 'Pausar vídeo del hero');
        heroToggle.querySelector('span').textContent = 'Ⅱ';
      } else {
        heroLoop.pause();
        heroToggle.setAttribute('aria-pressed', 'true');
        heroToggle.setAttribute('aria-label', 'Reproducir vídeo del hero');
        heroToggle.querySelector('span').textContent = '▶';
      }
    });
  }

  if (mediaRoot && !reduceMotion && window.matchMedia('(pointer: fine)').matches) {
    const photo = mediaRoot.querySelector('.real-hero-photo');
    const operationCard = mediaRoot.querySelector('.real-operations-card');

    mediaRoot.addEventListener('pointermove', (event) => {
      const rect = mediaRoot.getBoundingClientRect();
      const x = ((event.clientX - rect.left) / rect.width - .5) * 10;
      const y = ((event.clientY - rect.top) / rect.height - .5) * 8;
      if (photo) photo.style.transform = `translate3d(${-x * .2}px, ${-y * .18}px, 0)`;
      if (operationCard) operationCard.style.transform = `translate3d(${x * .35}px, ${y * .32}px, 20px)`;
    });

    mediaRoot.addEventListener('pointerleave', () => {
      if (photo) photo.style.transform = 'translate3d(0,0,0)';
      if (operationCard) operationCard.style.transform = 'translate3d(0,0,20px)';
    });
  }
</script>
