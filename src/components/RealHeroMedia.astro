---
const scenes = [
  {
    id: 'electrical',
    label: 'Electricidad',
    detail: 'Cuadros y maniobra',
    title: 'Intervención en cuadro eléctrico',
    video: 'https://videos.pexels.com/video-files/28886877/12504681_1920_1080_30fps.mp4',
    poster: 'https://images.pexels.com/photos/33694019/pexels-photo-33694019.jpeg?auto=compress&cs=tinysrgb&w=1600',
    alt: 'Técnico trabajando en un cuadro eléctrico industrial'
  },
  {
    id: 'plumbing',
    label: 'Fontanería',
    detail: 'Válvulas y tuberías',
    title: 'Revisión de una instalación de fontanería',
    video: 'https://videos.pexels.com/video-files/7584762/7584762-uhd_3840_2160_25fps.mp4',
    poster: 'https://images.pexels.com/videos/7584762/pexels-photo-7584762.jpeg?auto=compress&cs=tinysrgb&w=1600',
    alt: 'Profesional ajustando conexiones y válvulas de una instalación de agua'
  },
  {
    id: 'fire-protection',
    label: 'PCI',
    detail: 'Protección contra incendios',
    title: 'Equipos de protección contra incendios',
    video: 'https://videos.pexels.com/video-files/34775765/14743018_1920_1080_30fps.mp4',
    poster: 'https://images.pexels.com/videos/34775765/pexels-photo-34775765.jpeg?auto=compress&cs=tinysrgb&w=1600',
    alt: 'Equipos de protección contra incendios en una instalación industrial'
  },
  {
    id: 'security',
    label: 'Seguridad',
    detail: 'CCTV y supervisión',
    title: 'Supervisión de sistemas de seguridad',
    video: 'https://videos.pexels.com/video-files/7255101/7255101-uhd_4096_2160_30fps.mp4',
    poster: 'https://images.pexels.com/videos/7255101/cybersecurity-man-office-people-7255101.jpeg?auto=compress&cs=tinysrgb&w=1600',
    alt: 'Equipo supervisando cámaras y sistemas de seguridad desde una sala de control'
  },
  {
    id: 'telecom',
    label: 'Telecomunicaciones',
    detail: 'Redes y racks',
    title: 'Infraestructura de red y telecomunicaciones',
    video: 'https://videos.pexels.com/video-files/5028622/5028622-uhd_3840_2160_25fps.mp4',
    poster: 'https://images.pexels.com/videos/5028622/pexels-photo-5028622.jpeg?auto=compress&cs=tinysrgb&w=1600',
    alt: 'Racks de comunicaciones y equipos de red en una sala técnica'
  }
];
const firstScene = scenes[0];
---

<div class="hero-media-v6 hero-media-v7 reveal" data-hero-gallery aria-label="Secuencia automática de especialidades de mantenimiento e información operativa de IsiVoltPro">
  <div class="hero-stage-v6">
    <figure class="hero-video-v6">
      <img
        src={firstScene.poster}
        alt={firstScene.alt}
        width="1600"
        height="900"
        fetchpriority="high"
        decoding="async"
        data-hero-poster
      />
      <video muted playsinline preload="metadata" poster={firstScene.poster} data-hero-main-video>
        <source data-src={firstScene.video} type="video/mp4" />
      </video>
      <div class="hero-video-shade" aria-hidden="true"></div>

      <button class="hero-main-play" type="button" data-start-playlist aria-label="Reproducir secuencia de vídeos de mantenimiento">
        <span aria-hidden="true">▶</span>
      </button>

      <div class="hero-live-caption">
        <i aria-hidden="true"></i>
        <span>
          <strong data-scene-title>{firstScene.title}</strong>
          <small>Secuencia automática · sin sonido</small>
        </span>
        <button type="button" data-open-gallery-video>Ver en grande</button>
      </div>

      <div class="hero-playlist-progress" aria-label="Progreso de la secuencia">
        {scenes.map((scene, index) => (
          <button
            class:list={[index === 0 && 'active']}
            type="button"
            aria-label={`Reproducir ${scene.label}`}
            data-progress-button
            data-index={index}
          ><span></span></button>
        ))}
      </div>

      <button class="hero-video-toggle" type="button" data-toggle-gallery-video aria-label="Pausar vídeo" aria-pressed="false" hidden>
        <span aria-hidden="true">Ⅱ</span>
      </button>
    </figure>
  </div>

  <section class="hero-ot-strip-v6" aria-label="Ejemplo conceptual de una orden de trabajo">
    <div class="hero-ot-id-v6">
      <span>Orden en curso</span>
      <strong>OT-2026-0148</strong>
      <small>Planta 2 · Pasillo de quirófanos</small>
    </div>
    <div class="hero-ot-fact-v6">
      <span>Técnico</span>
      <strong>Equipo eléctrico</strong>
    </div>
    <div class="hero-ot-fact-v6">
      <span>Activo</span>
      <strong>CL-02 · Cuadro iluminación</strong>
    </div>
    <div class="hero-ot-status-v6">
      <span>En curso · 60 %</span>
      <div><i></i></div>
      <small>Actualizado a las 09:42</small>
    </div>
    <a href="/aplicaciones/mantenimiento-ot">Ver OT →</a>
  </section>

  <div class="hero-scenes-v6" role="tablist" aria-label="Elegir una especialidad de mantenimiento">
    <span class="hero-scenes-label-v6">Especialidades</span>
    <div class="hero-scenes-track-v6">
      {scenes.map((scene, index) => (
        <button
          class:list={['hero-scene-v6', index === 0 && 'active']}
          type="button"
          role="tab"
          aria-selected={index === 0 ? 'true' : 'false'}
          data-scene-button
          data-index={index}
          data-video={scene.video}
          data-poster={scene.poster}
          data-title={scene.title}
          data-alt={scene.alt}
        >
          <span class="hero-scene-thumb-v6">
            <img src={scene.poster} alt="" width="360" height="220" loading={index === 0 ? 'eager' : 'lazy'} decoding="async" />
            {index === 0 && <i aria-hidden="true">▶</i>}
          </span>
          <span><strong>{scene.label}</strong><small>{scene.detail}</small></span>
        </button>
      ))}
    </div>
  </div>
</div>

<dialog class="hero-gallery-dialog" data-gallery-dialog aria-label="Vídeos de especialidades de mantenimiento">
  <button class="hero-gallery-close" type="button" data-close-gallery aria-label="Cerrar vídeo">×</button>
  <div class="hero-gallery-frame">
    <video controls playsinline preload="none" poster={firstScene.poster} data-gallery-video>
      <source data-src={firstScene.video} type="video/mp4" />
      Tu navegador no puede reproducir este vídeo.
    </video>
    <div class="hero-gallery-copy">
      <strong data-gallery-title>{firstScene.title}</strong>
      <span>Material visual gratuito de apoyo para representar distintas especialidades. No corresponde a un cliente ni instalación real de IsiVoltPro.</span>
    </div>
  </div>
</dialog>

<script is:inline>
  const gallery = document.querySelector('[data-hero-gallery]');
  const mainVideo = gallery?.querySelector('[data-hero-main-video]');
  const mainSource = mainVideo?.querySelector('source[data-src]');
  const posterImage = gallery?.querySelector('[data-hero-poster]');
  const sceneTitle = gallery?.querySelector('[data-scene-title]');
  const sceneButtons = [...(gallery?.querySelectorAll('[data-scene-button]') || [])];
  const progressButtons = [...(gallery?.querySelectorAll('[data-progress-button]') || [])];
  const videoToggle = gallery?.querySelector('[data-toggle-gallery-video]');
  const startButton = gallery?.querySelector('[data-start-playlist]');
  const openDialogButton = gallery?.querySelector('[data-open-gallery-video]');
  const dialog = document.querySelector('[data-gallery-dialog]');
  const closeDialogButton = dialog?.querySelector('[data-close-gallery]');
  const dialogVideo = dialog?.querySelector('[data-gallery-video]');
  const dialogSource = dialogVideo?.querySelector('source[data-src]');
  const dialogTitle = dialog?.querySelector('[data-gallery-title]');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const connection = navigator.connection || navigator.mozConnection || navigator.webkitConnection;
  const saveData = Boolean(connection?.saveData);
  const canAutoplay = !reduceMotion && !saveData;
  const clipSeconds = 7;
  let currentIndex = 0;
  let mainLoaded = false;
  let inView = false;
  let userPaused = false;

  const currentButton = () => sceneButtons[currentIndex];

  const syncActiveState = () => {
    sceneButtons.forEach((item, index) => {
      const active = index === currentIndex;
      item.classList.toggle('active', active);
      item.setAttribute('aria-selected', String(active));
      const marker = item.querySelector('.hero-scene-thumb-v6 i');
      if (active && !marker) {
        const nextMarker = document.createElement('i');
        nextMarker.setAttribute('aria-hidden', 'true');
        nextMarker.textContent = '▶';
        item.querySelector('.hero-scene-thumb-v6')?.append(nextMarker);
      } else if (!active && marker) {
        marker.remove();
      }
    });
    progressButtons.forEach((item, index) => item.classList.toggle('active', index === currentIndex));
    currentButton()?.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'nearest', inline: 'nearest' });
  };

  const loadCurrentScene = ({ play = false } = {}) => {
    const button = currentButton();
    if (!button || !mainVideo || !mainSource) return;
    const video = button.dataset.video || '';
    const poster = button.dataset.poster || '';
    const title = button.dataset.title || '';

    mainVideo.pause();
    mainSource.setAttribute('src', video);
    mainVideo.setAttribute('poster', poster);
    mainVideo.currentTime = 0;
    mainVideo.load();
    mainLoaded = true;

    if (posterImage) {
      posterImage.src = poster;
      posterImage.alt = button.dataset.alt || '';
    }
    if (sceneTitle) sceneTitle.textContent = title;
    if (dialogTitle) dialogTitle.textContent = title;
    syncActiveState();

    if (play && inView && !userPaused) {
      mainVideo.play().then(() => gallery?.classList.add('is-playing')).catch(() => gallery?.classList.remove('is-playing'));
    }
  };

  const selectScene = (index, { play = true } = {}) => {
    currentIndex = (index + sceneButtons.length) % sceneButtons.length;
    loadCurrentScene({ play });
  };

  const advanceScene = () => selectScene(currentIndex + 1, { play: true });

  sceneButtons.forEach((button, index) => button.addEventListener('click', () => {
    userPaused = false;
    selectScene(index, { play: true });
  }));

  progressButtons.forEach((button, index) => button.addEventListener('click', () => {
    userPaused = false;
    selectScene(index, { play: true });
  }));

  startButton?.addEventListener('click', () => {
    userPaused = false;
    if (!mainLoaded) loadCurrentScene();
    mainVideo?.play().then(() => gallery?.classList.add('is-playing')).catch(() => gallery?.classList.remove('is-playing'));
  });

  if (gallery && mainVideo && mainSource) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        inView = entry.isIntersecting;
        if (inView) {
          if (!mainLoaded) loadCurrentScene();
          if (canAutoplay && !userPaused) {
            mainVideo.play().then(() => gallery.classList.add('is-playing')).catch(() => gallery.classList.remove('is-playing'));
          }
        } else {
          mainVideo.pause();
        }
      });
    }, { threshold: .18 });
    observer.observe(gallery);

    mainVideo.addEventListener('canplay', () => {
      gallery.classList.add('has-video');
      if (videoToggle) videoToggle.hidden = false;
    });

    mainVideo.addEventListener('playing', () => gallery.classList.add('is-playing'));
    mainVideo.addEventListener('pause', () => {
      if (inView && !mainVideo.ended) gallery.classList.remove('is-playing');
    });
    mainVideo.addEventListener('ended', advanceScene);
    mainVideo.addEventListener('timeupdate', () => {
      if (mainVideo.duration && mainVideo.currentTime >= Math.min(clipSeconds, Math.max(1, mainVideo.duration - .25))) {
        advanceScene();
      }
    });
  }

  videoToggle?.addEventListener('click', () => {
    if (!mainVideo) return;
    if (mainVideo.paused) {
      userPaused = false;
      if (!mainLoaded) loadCurrentScene();
      mainVideo.play().catch(() => {});
      videoToggle.setAttribute('aria-pressed', 'false');
      videoToggle.setAttribute('aria-label', 'Pausar vídeo');
      videoToggle.querySelector('span').textContent = 'Ⅱ';
    } else {
      userPaused = true;
      mainVideo.pause();
      videoToggle.setAttribute('aria-pressed', 'true');
      videoToggle.setAttribute('aria-label', 'Reproducir vídeo');
      videoToggle.querySelector('span').textContent = '▶';
    }
  });

  openDialogButton?.addEventListener('click', () => {
    const button = currentButton();
    if (dialogVideo && dialogSource && button) {
      dialogSource.setAttribute('src', button.dataset.video || '');
      dialogVideo.setAttribute('poster', button.dataset.poster || '');
      dialogVideo.load();
    }
    if (dialogTitle) dialogTitle.textContent = button?.dataset.title || '';
    dialog?.showModal();
  });

  const closeDialog = () => {
    dialogVideo?.pause();
    dialog?.close();
  };
  closeDialogButton?.addEventListener('click', closeDialog);
  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) closeDialog();
  });
</script>
