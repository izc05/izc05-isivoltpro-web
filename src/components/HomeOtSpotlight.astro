---
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const withBase = (href: string) => href === '/' ? base : `${base}${href.replace(/^\/+/, '')}`;
---

<section class="pv14-ot-strip" aria-labelledby="pv14-ot-strip-title">
  <div class="container">
    <a class="pv14-ot-strip-card" href={withBase('/aplicaciones/mantenimiento-ot')} data-premium-reveal>
      <div class="pv14-ot-strip-copy">
        <span class="pv14-ot-status"><i aria-hidden="true"></i> Aplicación operativa</span>
        <h2 id="pv14-ot-strip-title">IsiVoltPro OT ya conecta coordinación y técnicos</h2>
        <p>Clientes, instalaciones, asignación, estados, zona móvil y auditoría cronológica dentro de una misma orden de trabajo.</p>
      </div>
      <div class="pv14-ot-mini-flow" aria-label="Flujo de IsiVoltPro OT">
        <span>Panel central</span><b aria-hidden="true">→</b><span>Zona técnico</span><b aria-hidden="true">→</b><span>Seguimiento</span>
      </div>
      <span class="pv14-ot-strip-cta">Ver IsiVoltPro OT <i aria-hidden="true">→</i></span>
    </a>
  </div>
</section>
