---
interface Props {
  compact?: boolean;
  showMetrics?: boolean;
  label?: string;
}

const {
  compact = false,
  showMetrics = true,
  label = 'Interfaces reales y demostrativas del ecosistema IsiVoltPro'
} = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const slides = [
  {
    image: `${base}media/tools-dashboard.svg`,
    eyebrow: 'Recursos · Operativa',
    title: 'Herramientas QR/NFC',
    short: 'Herramientas',
    state: 'Operativa',
    alt: 'Centro operativo de IsiVoltPro Herramientas QR y NFC'
  },
  {
    image: `${base}media/ot-dashboard.svg`,
    eyebrow: 'Operaciones · Operativa',
    title: 'IsiVoltPro OT',
    short: 'OT',
    state: 'Operativa',
    alt: 'Panel operativo de órdenes de trabajo IsiVoltPro OT'
  },
  {
    image: `${base}media/inspections-dashboard.svg`,
    eyebrow: 'Ingeniería · En desarrollo',
    title: 'Inspecciones BT',
    short: 'Inspecciones',
    state: 'En desarrollo',
    alt: 'Panel de inspecciones eléctricas de baja tensión IsiVoltPro'
  }
];
---

<div class:list={['pv12-device-scene', compact && 'is-compact']} data-parallax-root data-device-carousel aria-label={label}>
  <div class="pv12-device-glow" aria-hidden="true"></div>

  {showMetrics && (
    <>
      <div class="pv12-float-metric metric-one" data-parallax="1.8">
        <span>Aplicaciones</span><strong>2</strong><small>operativas</small>
      </div>
      <div class="pv12-float-metric metric-two" data-parallax="2.2">
        <span>Órdenes</span><strong>Tiempo real</strong><small>coordinación y campo</small>
      </div>
      <div class="pv12-float-metric metric-three" data-parallax="1.45">
        <span>Identificación</span><strong>QR / NFC</strong><small>activos y herramientas</small>
      </div>
    </>
  )}

  <div class="pv12-laptop" data-parallax="0.7" data-scroll-parallax="0.55">
    <div class="pv12-laptop-lid">
      <span class="pv12-camera" aria-hidden="true"></span>
      <div class="pv12-laptop-screen">
        <div class="pv13-screen-stack">
          {slides.map((slide, index) => (
            <img
              class:list={['pv13-screen-slide', index === 0 && 'is-active']}
              src={slide.image}
              alt={slide.alt}
              loading={compact || index > 0 ? 'lazy' : 'eager'}
              decoding="async"
              data-device-slide={index}
              aria-hidden={index === 0 ? 'false' : 'true'}
            />
          ))}
          <div class="pv13-screen-caption" aria-live="polite">
            <i aria-hidden="true"></i>
            <div><span data-device-eyebrow>{slides[0].eyebrow}</span><strong data-device-title>{slides[0].title}</strong></div>
          </div>
        </div>
      </div>
    </div>
    <div class="pv12-laptop-base" aria-hidden="true"><span></span></div>
  </div>

  <div class="pv12-phone" data-parallax="1.65" data-scroll-parallax="1.1" aria-label="Vista móvil de las aplicaciones IsiVoltPro">
    <div class="pv12-phone-notch" aria-hidden="true"></div>
    <div class="pv12-phone-ui">
      <div class="pv13-phone-slide is-active" data-phone-slide="0">
        <div class="pv12-phone-top"><span>‹</span><b>Detalle de herramienta</b><span>•••</span></div>
        <div class="pv12-tool-illustration" aria-hidden="true">⚒</div>
        <h3>Taladro percutor 18 V</h3>
        <div class="pv13-phone-code"><span>HER-000245</span><b>Disponible</b></div>
        <dl>
          <div><dt>Categoría</dt><dd>Herramienta eléctrica</dd></div>
          <div><dt>Ubicación</dt><dd>Almacén principal</dd></div>
          <div><dt>Responsable</dt><dd>Sin asignar</dd></div>
        </dl>
        <button type="button" tabindex="-1">Nuevo préstamo</button>
      </div>

      <div class="pv13-phone-slide" data-phone-slide="1">
        <div class="pv12-phone-top"><span>‹</span><b>Orden de trabajo</b><span>•••</span></div>
        <div class="pv12-tool-illustration" aria-hidden="true">OT</div>
        <h3>Fallo de climatización</h3>
        <div class="pv13-phone-code"><span>OT-2026-00031</span><b class="is-blue">En curso</b></div>
        <dl>
          <div><dt>Prioridad</dt><dd>Urgente</dd></div>
          <div><dt>Ubicación</dt><dd>Quirófano 3</dd></div>
          <div><dt>Técnico</dt><dd>Miguel A.</dd></div>
        </dl>
        <button type="button" tabindex="-1">Registrar actuación</button>
      </div>

      <div class="pv13-phone-slide" data-phone-slide="2">
        <div class="pv12-phone-top"><span>‹</span><b>Inspección BT</b><span>•••</span></div>
        <div class="pv12-tool-illustration" aria-hidden="true">✓</div>
        <h3>Centro sanitario</h3>
        <div class="pv13-phone-code"><span>BT-2026-018</span><b class="is-amber">71%</b></div>
        <dl>
          <div><dt>Reglamento</dt><dd>REBT 2002</dd></div>
          <div><dt>Bloque</dt><dd>Mediciones</dd></div>
          <div><dt>Defectos</dt><dd>3 registrados</dd></div>
        </dl>
        <button type="button" tabindex="-1">Continuar inspección</button>
      </div>
    </div>
  </div>

  <div class="pv12-nfc-card" data-parallax="2.5" data-scroll-parallax="1.4" data-nfc-card aria-label="Etiqueta NFC y QR">
    <span class="pv12-nfc-wave">)))</span>
    <strong>NFC</strong>
    <div class="pv12-qr-pattern" aria-hidden="true"></div>
    <small>ID: HER-000245</small>
  </div>

  <span class="pv14-swipe-hint" aria-hidden="true">↔ Desliza para cambiar</span>

  <div class="pv13-carousel-controls" aria-label="Cambiar aplicación mostrada">
    {slides.map((slide, index) => (
      <button
        class:list={['pv13-carousel-dot', index === 0 && 'is-active']}
        type="button"
        aria-label={`Mostrar ${slide.title}`}
        aria-pressed={index === 0 ? 'true' : 'false'}
        data-device-dot={index}
      >
        <span class="pv14-tab-name">{slide.short}</span>
        <small>{slide.state}</small>
      </button>
    ))}
  </div>
</div>

<script is:inline>
  (() => {
    if (window.__pv13DeviceCarouselInit) return;
    window.__pv13DeviceCarouselInit = true;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const mobile = window.matchMedia('(max-width: 560px)').matches;
    const labels = [
      ['Recursos · Operativa', 'Herramientas QR/NFC'],
      ['Operaciones · Operativa', 'IsiVoltPro OT'],
      ['Ingeniería · En desarrollo', 'Inspecciones BT']
    ];

    document.querySelectorAll('[data-device-carousel]').forEach((scene) => {
      const slides = [...scene.querySelectorAll('[data-device-slide]')];
      const phoneSlides = [...scene.querySelectorAll('[data-phone-slide]')];
      const dots = [...scene.querySelectorAll('[data-device-dot]')];
      const eyebrow = scene.querySelector('[data-device-eyebrow]');
      const title = scene.querySelector('[data-device-title]');
      const nfc = scene.querySelector('[data-nfc-card]');
      let current = mobile && !scene.classList.contains('is-compact') ? 1 : 0;
      let timer;
      let touchStartX = 0;
      let touchStartY = 0;

      const show = (next) => {
        current = (next + slides.length) % slides.length;
        scene.setAttribute('data-current-slide', String(current));
        slides.forEach((slide, index) => {
          const active = index === current;
          slide.classList.toggle('is-active', active);
          slide.setAttribute('aria-hidden', String(!active));
        });
        phoneSlides.forEach((slide, index) => slide.classList.toggle('is-active', index === current));
        dots.forEach((dot, index) => {
          const active = index === current;
          dot.classList.toggle('is-active', active);
          dot.setAttribute('aria-pressed', String(active));
        });
        if (eyebrow) eyebrow.textContent = labels[current][0];
        if (title) title.textContent = labels[current][1];
        nfc?.classList.toggle('is-hidden', current !== 0);
      };

      const stop = () => window.clearInterval(timer);
      const start = () => {
        stop();
        if (!reduced && slides.length > 1) timer = window.setInterval(() => show(current + 1), 4300);
      };

      dots.forEach((dot, index) => dot.addEventListener('click', () => { show(index); start(); }));
      scene.addEventListener('mouseenter', stop, { passive: true });
      scene.addEventListener('mouseleave', start, { passive: true });
      scene.addEventListener('focusin', stop);
      scene.addEventListener('focusout', start);
      scene.addEventListener('touchstart', (event) => {
        const touch = event.changedTouches[0];
        touchStartX = touch.clientX;
        touchStartY = touch.clientY;
        stop();
      }, { passive: true });
      scene.addEventListener('touchend', (event) => {
        const touch = event.changedTouches[0];
        const deltaX = touch.clientX - touchStartX;
        const deltaY = touch.clientY - touchStartY;
        if (Math.abs(deltaX) > 42 && Math.abs(deltaX) > Math.abs(deltaY)) show(current + (deltaX < 0 ? 1 : -1));
        start();
      }, { passive: true });
      document.addEventListener('visibilitychange', () => document.hidden ? stop() : start());
      show(current);
      start();
    });
  })();
</script>
