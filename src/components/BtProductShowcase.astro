---
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const withBase = (href: string) => href === '/' ? base : `${base}${href.replace(/^\/+/, '')}`;
const publicAppUrl = 'https://izc05.github.io/isivolpro-inspecciones/';

const capabilities = [
  { code: 'BT', title: 'Flujo guiado REBT', text: 'Datos de instalación, reglamento aplicable, bloques técnicos, checklist, mediciones y conclusión en un recorrido ordenado.' },
  { code: 'OFF', title: 'Trabajo sin cobertura', text: 'La preinspección permanece disponible en el dispositivo y conserva los cambios pendientes hasta recuperar conexión.' },
  { code: 'PC', title: 'Continuidad móvil–PC', text: 'La misma preinspección mantiene un identificador estable para poder continuarla y revisarla desde diferentes dispositivos.' },
  { code: 'EVI', title: 'Evidencias protegidas', text: 'Fotografías, firmas y documentos se relacionan con el expediente, evitando duplicados y verificando su integridad.' },
  { code: 'GPS', title: 'Cierre presencial', text: 'La empresa puede exigir cierre desde la APK, dentro del radio configurado y con precisión GPS suficiente.' },
  { code: 'PDF', title: 'Informe profesional', text: 'Mediciones, observaciones, defectos, fotografías y resultado se preparan para revisión y exportación.' }
];

const workflow = [
  ['01', 'Preparar', 'Crear el expediente, identificar la instalación y seleccionar el reglamento o alcance de la preinspección.'],
  ['02', 'Inspeccionar', 'Completar bloques, checklist y mediciones desde móvil, tableta o PC, incluso sin cobertura.'],
  ['03', 'Documentar', 'Relacionar defectos, fotografías, firmas y documentos con los puntos técnicos correspondientes.'],
  ['04', 'Sincronizar', 'Enviar cambios al servidor, detectar conflictos y continuar el mismo expediente desde otro dispositivo.'],
  ['05', 'Cerrar', 'Validar requisitos, ubicación presencial y revisión del servidor antes del cierre definitivo.']
];
---

<section class="bt-hero">
  <div class="container bt-hero-grid">
    <div class="bt-copy" data-premium-reveal>
      <span class="bt-status"><i aria-hidden="true"></i> Beta operativa · Local-first</span>
      <p class="eyebrow">IsiVoltPro · Ingeniería eléctrica</p>
      <h1>Preinspecciones de baja tensión con continuidad entre <span>campo y oficina</span></h1>
      <p class="lead">Una aplicación para preparar, ejecutar y revisar preinspecciones BT con checklist, mediciones, defectos, fotografías, firmas e informe, manteniendo el trabajo disponible aunque no haya cobertura.</p>
      <div class="bt-badges" aria-label="Características principales">
        <span>REBT 1973/2002</span><span>APK Android</span><span>Versión web</span><span>Modo offline</span><span>Cierre GPS</span>
      </div>
      <div class="bt-actions">
        <a class="button button-primary" href={publicAppUrl} target="_blank" rel="noreferrer">Abrir versión web actual →</a>
        <a class="button button-secondary" href={withBase('/contacto')}>Solicitar acceso a la beta</a>
      </div>
      <p class="bt-note">La sincronización servidor, los archivos protegidos y el cierre GPS están validados en una rama técnica y se activarán tras completar el despliegue real.</p>
    </div>

    <div class="bt-visual" data-premium-reveal aria-label="Vista conceptual del expediente de preinspección">
      <div class="bt-window">
        <div class="bt-window-bar"><span></span><span></span><span></span><strong>PREINSPECCIÓN BT</strong></div>
        <div class="bt-dashboard">
          <aside>
            <b>BT-2026-0042</b>
            <small>Centro sanitario · Cuadro QGBT-2</small>
            <nav>
              <span class="active">Resumen</span><span>Bloques</span><span>Mediciones</span><span>Defectos</span><span>Evidencias</span><span>Informe</span>
            </nav>
          </aside>
          <main>
            <div class="bt-summary-head"><div><small>ESTADO</small><strong>EN REVISIÓN</strong></div><div><small>SINCRONIZACIÓN</small><strong class="sync">Confirmada</strong></div></div>
            <div class="bt-kpis"><article><b>8/10</b><span>Bloques</span></article><article><b>24</b><span>Mediciones</span></article><article><b>3</b><span>Defectos</span></article><article><b>12</b><span>Fotos</span></article></div>
            <div class="bt-checks">
              <article><i class="ok">✓</i><div><b>Puesta a tierra</b><span>Mediciones registradas</span></div><strong>OK</strong></article>
              <article><i class="warn">!</i><div><b>Protecciones</b><span>Un defecto pendiente de revisar</span></div><strong>REVISAR</strong></article>
              <article><i class="ok">✓</i><div><b>Documentación</b><span>Unifilar y fotografías vinculadas</span></div><strong>OK</strong></article>
            </div>
          </main>
        </div>
      </div>
      <div class="bt-phone">
        <small>CIERRE PRESENCIAL</small>
        <b>Ubicación validada</b>
        <span>Distancia: 18 m</span>
        <span>Precisión: 7 m</span>
        <button type="button" tabindex="-1">Cerrar preinspección</button>
      </div>
    </div>
  </div>
</section>

<section class="bt-section is-soft">
  <div class="container">
    <div class="bt-heading" data-premium-reveal>
      <p class="eyebrow">Una única fuente de trabajo</p>
      <h2>La inspección no vuelve a empezar al cambiar de dispositivo</h2>
      <p>El expediente conserva su identidad, revisión y evidencias. Los cambios incompatibles se muestran como conflicto en lugar de sobrescribir trabajo de campo.</p>
    </div>
    <div class="bt-device-grid">
      <article data-premium-reveal><span>APK</span><h3>Trabajo de campo</h3><p>Captura mediciones, observaciones, fotografías y firmas con una interfaz preparada para móvil y funcionamiento offline.</p><ul><li>Datos siempre disponibles en local</li><li>Cola de cambios pendientes</li><li>GPS y permisos nativos</li></ul></article>
      <article data-premium-reveal><span>PC</span><h3>Revisión y documentación</h3><p>Continúa el mismo expediente desde navegador para revisar bloques, completar información y preparar el informe.</p><ul><li>Vista amplia del expediente</li><li>Control de revisiones</li><li>Informe y evidencias reunidos</li></ul></article>
      <article class="is-dark" data-premium-reveal><span>SYNC</span><h3>Servidor propio</h3><p>La arquitectura prevista utiliza PocketBase en infraestructura IsiVoltPro, con separación por empresa y acceso mediante la misma cuenta.</p><ul><li>Sin segunda contraseña</li><li>Archivos privados y verificados</li><li>Auditoría de sincronización y cierre</li></ul></article>
    </div>
  </div>
</section>

<section class="bt-section">
  <div class="container">
    <div class="bt-heading" data-premium-reveal><p class="eyebrow">Capacidad técnica</p><h2>Preparada para el ciclo completo de una preinspección</h2></div>
    <div class="bt-capability-grid">
      {capabilities.map((item, index) => (
        <article data-premium-reveal style={`transition-delay:${index * 55}ms`}><i>{item.code}</i><h3>{item.title}</h3><p>{item.text}</p></article>
      ))}
    </div>
  </div>
</section>

<section class="bt-section is-soft">
  <div class="container">
    <div class="bt-heading" data-premium-reveal><p class="eyebrow">Flujo conectado</p><h2>Del alta al cierre presencial, sin perder trazabilidad</h2></div>
    <div class="bt-workflow">
      {workflow.map((step, index) => (
        <article data-premium-reveal style={`transition-delay:${index * 65}ms`}><b>{step[0]}</b><h3>{step[1]}</h3><p>{step[2]}</p></article>
      ))}
    </div>
  </div>
</section>

<section class="bt-section">
  <div class="container">
    <div class="bt-readiness" data-premium-reveal>
      <div>
        <p class="eyebrow">Estado del producto</p>
        <h2>Beta funcional con integración conectada preparada</h2>
        <p>La versión pública actual funciona como aplicación local-first. La rama conectada ya ha superado pruebas de sincronización, archivos protegidos, PocketBase, compilación web y APK Android.</p>
      </div>
      <div>
        <strong>Pendiente antes de producción</strong>
        <ul><li>Desplegar el servidor en el mini PC</li><li>Publicar los dominios BT</li><li>Prueba real móvil–PC y cierre GPS</li><li>APK release firmada</li></ul>
        <a class="button button-primary" href={withBase('/contacto')}>Participar en la validación →</a>
      </div>
    </div>
    <p class="bt-disclaimer" data-premium-reveal><strong>Alcance:</strong> IsiVoltPro Preinspecciones BT ayuda a recopilar, revisar y documentar información técnica. No sustituye una inspección reglamentaria oficial, un certificado ni el criterio del profesional habilitado.</p>
  </div>
</section>

<style>
  .bt-hero{position:relative;overflow:hidden;padding:clamp(5rem,9vw,8rem) 0;background:radial-gradient(circle at 75% 20%,rgba(37,199,255,.18),transparent 32%),linear-gradient(135deg,#06172d 0%,#0a2547 58%,#071a33 100%);color:#fff}.bt-hero:before{content:"";position:absolute;inset:0;background-image:linear-gradient(rgba(255,255,255,.035) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.035) 1px,transparent 1px);background-size:42px 42px;mask-image:linear-gradient(to bottom,black,transparent 90%)}.bt-hero-grid{position:relative;display:grid;grid-template-columns:minmax(0,.9fr) minmax(440px,1.1fr);gap:clamp(3rem,6vw,6rem);align-items:center}.bt-copy h1{max-width:780px;font-size:clamp(2.7rem,5.7vw,5.6rem);line-height:.97;letter-spacing:-.055em;margin:.65rem 0 1.35rem}.bt-copy h1 span{color:#55d5ff}.bt-copy .lead{max-width:760px;color:#c9d9eb}.bt-status{display:inline-flex;align-items:center;gap:.55rem;padding:.55rem .85rem;border:1px solid rgba(92,225,170,.32);border-radius:999px;background:rgba(20,123,84,.18);font-weight:800;font-size:.78rem;letter-spacing:.08em;text-transform:uppercase;color:#a4f0cf}.bt-status i{width:.55rem;height:.55rem;border-radius:50%;background:#5ce1aa;box-shadow:0 0 0 6px rgba(92,225,170,.12)}.bt-badges{display:flex;flex-wrap:wrap;gap:.55rem;margin:1.5rem 0}.bt-badges span{padding:.48rem .72rem;border:1px solid rgba(255,255,255,.14);border-radius:999px;background:rgba(255,255,255,.06);font-size:.82rem;color:#d8e5f2}.bt-actions{display:flex;flex-wrap:wrap;gap:.75rem;margin-top:1.6rem}.bt-hero .button-secondary{border-color:rgba(255,255,255,.28);color:#fff;background:rgba(255,255,255,.06)}.bt-note{margin-top:1rem;max-width:700px;font-size:.82rem;color:#93abc3}.bt-visual{position:relative;min-width:0}.bt-window{border:1px solid rgba(255,255,255,.16);border-radius:24px;background:#f5f8fc;box-shadow:0 35px 100px rgba(0,0,0,.38);overflow:hidden;transform:perspective(1400px) rotateY(-3deg) rotateX(1deg)}.bt-window-bar{height:46px;display:flex;align-items:center;gap:8px;padding:0 16px;background:#0b213d;color:#fff}.bt-window-bar span{width:9px;height:9px;border-radius:50%;background:#51708d}.bt-window-bar strong{margin-left:auto;font-size:.67rem;letter-spacing:.13em}.bt-dashboard{display:grid;grid-template-columns:145px 1fr;min-height:410px;color:#10263d}.bt-dashboard aside{padding:22px 16px;background:#eaf0f7;border-right:1px solid #dbe4ee}.bt-dashboard aside b{font-size:.86rem}.bt-dashboard aside small{display:block;margin:.3rem 0 1.3rem;font-size:.62rem;color:#617489}.bt-dashboard nav{display:grid;gap:.42rem}.bt-dashboard nav span{padding:.65rem .7rem;border-radius:9px;font-size:.67rem;font-weight:700;color:#63768a}.bt-dashboard nav .active{background:#fff;color:#0b63a8;box-shadow:0 8px 20px rgba(20,48,78,.08)}.bt-dashboard main{padding:22px}.bt-summary-head{display:flex;justify-content:space-between;gap:1rem;padding-bottom:16px;border-bottom:1px solid #dce5ee}.bt-summary-head small{display:block;font-size:.55rem;color:#718398}.bt-summary-head strong{font-size:.72rem}.bt-summary-head .sync{color:#15855c}.bt-kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin:16px 0}.bt-kpis article{padding:12px;border:1px solid #dde6ef;border-radius:12px;background:#fff}.bt-kpis b{display:block;font-size:1.05rem;color:#0968aa}.bt-kpis span{font-size:.58rem;color:#718398}.bt-checks{display:grid;gap:9px}.bt-checks article{display:grid;grid-template-columns:28px 1fr auto;align-items:center;gap:9px;padding:12px;border:1px solid #e0e7ef;border-radius:12px;background:#fff}.bt-checks i{display:grid;place-items:center;width:26px;height:26px;border-radius:8px;font-style:normal;font-weight:900}.bt-checks .ok{background:#e4f8ef;color:#11835c}.bt-checks .warn{background:#fff3d9;color:#b27400}.bt-checks b,.bt-checks span{display:block}.bt-checks b{font-size:.68rem}.bt-checks span{font-size:.56rem;color:#73869a}.bt-checks strong{font-size:.55rem;color:#527087}.bt-phone{position:absolute;right:-16px;bottom:-38px;width:178px;padding:18px;border:1px solid rgba(255,255,255,.24);border-radius:22px;background:#0b213d;box-shadow:0 22px 50px rgba(0,0,0,.42);display:grid;gap:.4rem}.bt-phone small{color:#69d9ff;font-size:.55rem;letter-spacing:.12em}.bt-phone b{font-size:.9rem}.bt-phone span{font-size:.68rem;color:#adc0d3}.bt-phone button{margin-top:.5rem;padding:.7rem;border:0;border-radius:9px;background:#24b47e;color:#fff;font-weight:800;font-size:.68rem}.bt-section{padding:clamp(4.5rem,8vw,7rem) 0}.bt-section.is-soft{background:#f2f6fa}.bt-heading{max-width:820px;margin-bottom:2.3rem}.bt-heading h2{font-size:clamp(2rem,4vw,3.7rem);line-height:1.04;letter-spacing:-.045em;margin:.35rem 0 .8rem}.bt-heading>p:last-child{font-size:1.05rem;color:#627386}.bt-device-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.bt-device-grid article{padding:2rem;border:1px solid #dce5ed;border-radius:22px;background:#fff;box-shadow:0 16px 40px rgba(17,45,73,.06)}.bt-device-grid article>span{display:inline-grid;place-items:center;min-width:48px;height:34px;padding:0 .65rem;border-radius:9px;background:#e8f4fb;color:#0968aa;font-size:.68rem;font-weight:900}.bt-device-grid h3{margin:1.2rem 0 .6rem;font-size:1.35rem}.bt-device-grid p,.bt-device-grid li{color:#65778a}.bt-device-grid ul{padding-left:1.1rem}.bt-device-grid .is-dark{background:#071c35;color:#fff;border-color:#071c35}.bt-device-grid .is-dark p,.bt-device-grid .is-dark li{color:#b9cada}.bt-capability-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.bt-capability-grid article{padding:1.6rem;border-top:3px solid #1fa5d8;background:#f7f9fb;border-radius:0 0 16px 16px}.bt-capability-grid i{display:inline-flex;padding:.38rem .5rem;border-radius:7px;background:#dff3fa;color:#0876a1;font-size:.65rem;font-weight:900;font-style:normal}.bt-capability-grid h3{margin:1rem 0 .45rem}.bt-capability-grid p{color:#67798b}.bt-workflow{display:grid;grid-template-columns:repeat(5,1fr);gap:.8rem}.bt-workflow article{position:relative;padding:1.6rem 1.2rem;border-radius:18px;background:#fff;border:1px solid #dde6ee}.bt-workflow article:not(:last-child):after{content:"→";position:absolute;right:-.72rem;top:1.6rem;z-index:2;color:#38a9d4;font-weight:900}.bt-workflow b{font-size:1.7rem;color:#b9ddec}.bt-workflow h3{margin:.6rem 0}.bt-workflow p{font-size:.9rem;color:#687a8c}.bt-readiness{display:grid;grid-template-columns:1.1fr .9fr;gap:2rem;padding:clamp(2rem,5vw,4rem);border-radius:28px;background:linear-gradient(135deg,#071a33,#0b315b);color:#fff}.bt-readiness h2{font-size:clamp(2rem,4vw,3.5rem);line-height:1.05}.bt-readiness p,.bt-readiness li{color:#bed0e2}.bt-readiness strong{display:block;margin-bottom:.8rem;color:#6ddcff}.bt-readiness ul{padding-left:1.1rem;margin-bottom:1.5rem}.bt-disclaimer{margin:1.5rem auto 0;max-width:980px;padding:1rem 1.2rem;border-left:3px solid #f1b24a;background:#fff8e9;color:#6c5a36;font-size:.86rem}.bt-disclaimer strong{color:#493a1f}@media(max-width:1000px){.bt-hero-grid{grid-template-columns:1fr}.bt-visual{max-width:760px}.bt-device-grid,.bt-capability-grid{grid-template-columns:repeat(2,1fr)}.bt-workflow{grid-template-columns:repeat(2,1fr)}.bt-workflow article:after{display:none}}@media(max-width:640px){.bt-hero{padding-top:4.5rem}.bt-copy h1{font-size:2.65rem}.bt-dashboard{grid-template-columns:1fr}.bt-dashboard aside{display:none}.bt-kpis{grid-template-columns:repeat(2,1fr)}.bt-phone{position:relative;right:auto;bottom:auto;margin:-12px 16px 0 auto}.bt-device-grid,.bt-capability-grid,.bt-workflow,.bt-readiness{grid-template-columns:1fr}.bt-actions .button{width:100%;text-align:center}.bt-window{transform:none}.bt-readiness{padding:1.6rem}}
</style>
