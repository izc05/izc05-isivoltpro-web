---
import { brand } from '../data/brand';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const withBase = (href: string) => {
  if (href === '/') return base;
  const [pathname, hash] = href.split('#');
  const resolved = `${base}${pathname.replace(/^\/+/, '')}`;
  return hash === undefined ? resolved : `${resolved}#${hash}`;
};
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid footer-grid-expanded">
      <div class="footer-brand-column">
        <a class="brand" href={withBase('/')} aria-label="IsiVoltPro, inicio">IsiVolt<span class="accent">Pro</span></a>
        <p>{brand.tagline} Aplicaciones profesionales, modulares y preparadas para crecer.</p>
        <a class="footer-domain" href={brand.url}>{brand.domain}</a>
        <span class="footer-status"><i></i> Herramientas QR/NFC operativa</span>
      </div>

      <div>
        <h3>Producto</h3>
        <div class="footer-links">
          <a href={withBase('/aplicaciones')}>Aplicaciones</a>
          <a href={withBase('/aplicaciones/herramientas-maletines')}>Herramientas QR/NFC</a>
          <a href={withBase('/ecosistema')}>Ecosistema</a>
          <a href={withBase('/mantenimiento')}>Soluciones</a>
        </div>
      </div>

      <div>
        <h3>Recursos</h3>
        <div class="footer-links">
          <a href={withBase('/recursos')}>Blog técnico</a>
          <a href={withBase('/infraestructura')}>Infraestructura</a>
          <a href={withBase('/sobre-isivoltpro')}>Sobre IsiVoltPro</a>
          <a href={withBase('/contacto')}>Contacto</a>
        </div>
      </div>

      <div>
        <h3>Contacto</h3>
        <div class="footer-links">
          <a class="brand-email" href={`mailto:${brand.email}`}>{brand.email}</a>
          <span>{brand.location}</span>
          <a href="https://qr.isivoltpro.com/" target="_blank" rel="noopener noreferrer">Abrir Herramientas QR</a>
          <span>Datos bajo tu control</span>
        </div>
      </div>
    </div>

    <div class="footer-bottom footer-bottom-expanded">
      <span>© 2026 {brand.name} · Ecosistema digital creado desde el mantenimiento real</span>
      <nav aria-label="Información legal">
        <a href={withBase('/aviso-legal')}>Aviso legal</a>
        <a href={withBase('/privacidad')}>Privacidad</a>
        <a href={withBase('/cookies')}>Cookies</a>
        <button class="footer-privacy-button" type="button" data-open-privacy-settings>Preferencias</button>
      </nav>
    </div>
  </div>
</footer>
