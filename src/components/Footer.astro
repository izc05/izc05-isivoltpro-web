---
import { brand } from '../data/brand';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const withBase = (href: string) => {
  if (href === '/') return base;
  const [pathname, hash] = href.split('#');
  const resolved = `${base}${pathname.replace(/^\/+/, '')}`;
  return hash === undefined ? resolved : `${resolved}#${hash}`;
};
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <a class="brand" href={withBase('/')} aria-label="IsiVoltPro, inicio"><span class="brand-mark">I</span>IsiVolt<span class="accent">Pro</span></a>
        <p style="margin-top:18px">{brand.tagline}</p>
        <a href={brand.url}>{brand.domain}</a>
      </div>
      <div>
        <h3>Ecosistema</h3>
        <div class="footer-links">
          <a href={withBase('/ecosistema')}>Explorar</a>
          <a href={withBase('/aplicaciones')}>Aplicaciones</a>
          <a href={withBase('/#mantenimiento')}>Mantenimiento</a>
        </div>
      </div>
      <div>
        <h3>Recursos</h3>
        <div class="footer-links">
          <a href={withBase('/recursos')}>Centro de conocimiento</a>
          <a href={withBase('/#infraestructura')}>Infraestructura</a>
          <a href={withBase('/aplicaciones/mantenimiento-ot')}>IsiVoltPro OT</a>
        </div>
      </div>
      <div>
        <h3>Contacto</h3>
        <div class="footer-links">
          <a class="brand-email" href={`mailto:${brand.email}`}>{brand.email}</a>
          <a href={withBase('/contacto')}>Página de contacto</a>
          <span>{brand.location}</span>
          <span>© 2026 {brand.name}</span>
        </div>
      </div>
    </div>
    <div class="footer-bottom">IsiVoltPro · Tecnología creada desde el mantenimiento real</div>
  </div>
</footer>
