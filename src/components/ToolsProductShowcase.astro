---
import AppDeviceVisual from './AppDeviceVisual.astro';
import type { EcosystemArea } from '../data/catalog';

interface Props { area: EcosystemArea; }
const { area } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const withBase = (href: string) => href === '/' ? base : `${base}${href.replace(/^\/+/, '')}`;
const dashboardImage = `${base}media/tools-dashboard.svg`;
const appUrl = 'https://qr.isivoltpro.com/';

const features = [
  { icon: '▤', title: 'Inventario inteligente', text: 'Herramientas, equipos, EPI, maletines y materiales con código, categoría, estado y ubicación.' },
  { icon: '♙', title: 'Asignación a técnicos', text: 'Responsables, especialidades y material entregado con consulta inmediata.' },
  { icon: '↔', title: 'Préstamos y devoluciones', text: 'Salidas, entradas, responsables, fechas y lotes con control de disponibilidad.' },
  { icon: '▦', title: 'Etiquetado QR/NFC', text: 'Identificación rápida para consultar, prestar, devolver o revisar un equipo.' },
  { icon: '◷', title: 'Historial y trazabilidad', text: 'Cronología completa de movimientos, ubicaciones, incidencias y responsables.' },
  { icon: '▧', title: 'Incidencias y evidencias', text: 'Fotografías, observaciones y estados de revisión asociados a cada elemento.' },
  { icon: '◉', title: 'Stock y control', text: 'Disponibilidad, ubicación, stock mínimo y alertas para evitar roturas de inventario.' },
  { icon: '⚙', title: 'Preparada para crecer', text: 'Arquitectura lista para sincronización y conexión futura con OT y activos.' }
];

const dailyFlow = [
  { icon: '▤', title: 'Alta', text: 'Registra la herramienta y crea su ficha.' },
  { icon: '▦', title: 'Etiquetado', text: 'Genera QR y vincula NFC.' },
  { icon: '♙', title: 'Asignación', text: 'Selecciona técnico y responsable.' },
  { icon: '⚒', title: 'Uso', text: 'El equipo queda trazado en campo.' },
  { icon: '↶', title: 'Devolución', text: 'Valida entrada y estado.' },
  { icon: '◷', title: 'Historial', text: 'Consulta movimientos y evidencias.' }
];

const modules = [
  { title: 'Inicio', text: 'Centro operativo y actividad reciente.' },
  { title: 'Herramientas', text: 'Inventario, filtros y estados.' },
  { title: 'Técnicos', text: 'Responsables y material asignado.' },
  { title: 'Movimientos', text: 'Préstamos, devoluciones y lotes.' },
  { title: 'QR/NFC', text: 'Etiquetas, lectura y vinculación.' },
  { title: 'Configuración', text: 'Catálogos, espacios y preferencias.' }
];

const integrations = [
  { icon: '▣', name: 'Operaciones OT', text: 'Órdenes y mantenimientos' },
  { icon: '✓', name: 'Inspecciones BT', text: 'Evidencias y verificaciones' },
  { icon: '▥', name: 'RITE', text: 'Equipos térmicos' },
  { icon: '♨', name: 'PCI', text: 'Equipos contra incendios' },
  { icon: '◯', name: 'Legionella', text: 'Puntos y controles' },
  { icon: '▦', name: 'Activos QR/NFC', text: 'Esta aplicación', current: true }
];
---

<section class="pv12-tools-hero">
  <div class="container pv12-tools-grid">
    <div data-premium-reveal>
      <p class="eyebrow">Herramientas · activos QR/NFC</p>
      <h1>Control total de herramientas y activos <span class="accent">con QR y NFC</span></h1>
      <p class="lead">Inventario inteligente, asignación a técnicos, préstamos, devoluciones, trazabilidad e historial. La primera aplicación real del ecosistema IsiVoltPro ya está publicada y funcionando.</p>
      <div class="pv12-hero-actions">
        <a class="button button-primary" href={appUrl} target="_blank" rel="noopener noreferrer">Abrir aplicación →</a>
        <a class="button button-secondary" href={withBase('/contacto')}>Solicitar demo</a>
      </div>
      <div class="pv12-tools-badges">
        <span class="pv12-tools-badge"><i>◇</i> Datos bajo tu control</span>
        <span class="pv12-tools-badge"><i>☁</i> Local y preparada para nube</span>
        <span class="pv12-tools-badge"><i>▯</i> Diseñada para móvil</span>
      </div>
    </div>
    <div data-premium-reveal><AppDeviceVisual /></div>
  </div>
</section>

<section class="pv12-section is-soft" id="funciones">
  <div class="container">
    <div class="pv12-section-head" data-premium-reveal>
      <h2>Todo lo necesario para gestionar herramientas y activos</h2>
      <p>La aplicación convierte altas, etiquetas y movimientos en una operación clara para almacén, coordinación y técnicos.</p>
    </div>
    <div class="pv12-tools-feature-grid">
      {features.map((item, index) => (
        <article class="pv12-tools-feature" data-premium-reveal style={`transition-delay:${index * 45}ms`}>
          <i>{item.icon}</i><h3>{item.title}</h3><p>{item.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="pv12-section">
  <div class="container">
    <div class="pv12-section-head" data-premium-reveal><h2>Así funciona en el día a día</h2></div>
    <div class="pv12-tools-day">
      {dailyFlow.map((item, index) => (
        <article class="pv12-tools-step" data-premium-reveal style={`transition-delay:${index * 60}ms`}>
          <b>{index + 1}</b><i>{item.icon}</i><h3>{item.title}</h3><p>{item.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="pv12-section is-soft">
  <div class="container">
    <div class="pv12-section-head" data-premium-reveal>
      <h2>Módulos de la aplicación</h2>
      <p>Pantallas reales del centro operativo actual, organizadas por las tareas principales.</p>
    </div>
    <div class="pv12-module-grid">
      {modules.map((module, index) => (
        <article class="pv12-module-card" data-premium-reveal style={`transition-delay:${index * 50}ms`}>
          <div class="pv12-module-shot"><img src={dashboardImage} alt={`Vista del módulo ${module.title} de Herramientas QR`} loading="lazy" decoding="async" /></div>
          <div class="pv12-module-copy"><h3>{module.title}</h3><p>{module.text}</p></div>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="pv12-section">
  <div class="container pv12-tools-panels">
    <article class="pv12-tools-panel" data-premium-reveal>
      <p class="eyebrow">Dashboard web</p>
      <h2>Control para coordinación y almacén</h2>
      <p>Resumen de herramientas, disponibilidad, responsables, actividad reciente y puesta en marcha del espacio local.</p>
      <a class="button button-secondary" href={appUrl} target="_blank" rel="noopener noreferrer">Ver dashboard</a>
      <img class="pv12-panel-image" src={dashboardImage} alt="Dashboard real de Herramientas QR" loading="lazy" decoding="async" />
    </article>

    <article class="pv12-tools-panel" data-premium-reveal>
      <p class="eyebrow">Etiquetas e identificación</p>
      <h2>Diseñador QR y vinculación NFC</h2>
      <p>Cada herramienta puede disponer de una identidad física para abrir su ficha y registrar movimientos con menos pasos.</p>
      <div class="pv12-label-designer">
        <small>Vista previa de etiqueta</small>
        <div class="pv12-label-preview">
          <div class="pv12-qr-pattern" aria-hidden="true"></div>
          <div><strong>IsiVoltPro<br />HER-000245</strong><small>Taladro percutor 18 V · NFC</small></div>
        </div>
      </div>
    </article>
  </div>
</section>

<section class="pv12-section is-soft">
  <div class="container">
    <div class="pv12-section-head" data-premium-reveal><h2>Parte del ecosistema IsiVoltPro</h2><p>Herramientas QR/NFC es la primera pieza operativa y la base de futuras conexiones.</p></div>
    <div class="pv12-integration-grid">
      {integrations.map((item, index) => (
        <a class:list={['pv12-integration-card', item.current && 'is-current']} href={item.current ? appUrl : withBase('/ecosistema')} target={item.current ? '_blank' : undefined} rel={item.current ? 'noopener noreferrer' : undefined} data-premium-reveal style={`transition-delay:${index * 50}ms`}>
          <i>{item.icon}</i><strong>{item.name}</strong><small>{item.text}</small>
        </a>
      ))}
    </div>
  </div>
</section>

<section class="pv12-section" style="padding-top:0">
  <div class="container">
    <div class="pv12-final-cta" data-premium-reveal>
      <span class="pv12-final-cta-icon">▣</span>
      <div><h2>Lleva el control de tus herramientas al siguiente nivel</h2><p>Menos pérdidas, más control y trazabilidad completa en cada movimiento.</p></div>
      <div class="pv12-hero-actions" style="margin:0">
        <a class="button button-primary" href={withBase('/contacto')}>Solicitar demo</a>
        <a class="button button-dark" href={appUrl} target="_blank" rel="noopener noreferrer">Abrir aplicación</a>
      </div>
    </div>
  </div>
</section>
