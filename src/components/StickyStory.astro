<section class="story-section" id="flujo" aria-labelledby="story-title" data-story>
  <div class="container story-heading reveal">
    <div>
      <p class="eyebrow">Del aviso al conocimiento</p>
      <h2 id="story-title">El mantenimiento avanza. La información también.</h2>
    </div>
    <p class="lead">Desplázate para recorrer un flujo completo. El panel permanece visible y cambia a medida que cada etapa entra en pantalla.</p>
  </div>

  <div class="container story-layout">
    <div class="story-steps" aria-label="Etapas del flujo de mantenimiento">
      <article class="story-step is-active" data-story-step="0">
        <span class="story-number">01</span>
        <p class="story-kicker">Detectar</p>
        <h3>El aviso llega con contexto</h3>
        <p>Ubicación, prioridad, fotografías y descripción quedan reunidas desde el primer momento.</p>
        <div class="story-tags"><span>Incidencia</span><span>Ubicación</span><span>Prioridad</span></div>
      </article>

      <article class="story-step" data-story-step="1">
        <span class="story-number">02</span>
        <p class="story-kicker">Coordinar</p>
        <h3>La orden encuentra al equipo adecuado</h3>
        <p>Especialidad, carga de trabajo, urgencia y materiales ayudan a decidir la asignación.</p>
        <div class="story-tags"><span>Técnico</span><span>Agenda</span><span>Stock</span></div>
      </article>

      <article class="story-step" data-story-step="2">
        <span class="story-number">03</span>
        <p class="story-kicker">Intervenir</p>
        <h3>El activo se identifica en campo</h3>
        <p>Un código QR o NFC abre la ficha, el historial y las instrucciones desde el móvil.</p>
        <div class="story-tags"><span>QR/NFC</span><span>Activo</span><span>Historial</span></div>
      </article>

      <article class="story-step" data-story-step="3">
        <span class="story-number">04</span>
        <p class="story-kicker">Verificar</p>
        <h3>Mediciones y evidencias cierran el círculo</h3>
        <p>Checklist, valores, fotografías y observaciones dejan una actuación comprobable.</p>
        <div class="story-tags"><span>Checklist</span><span>Medición</span><span>Evidencia</span></div>
      </article>

      <article class="story-step" data-story-step="4">
        <span class="story-number">05</span>
        <p class="story-kicker">Aprender</p>
        <h3>El trabajo se convierte en conocimiento</h3>
        <p>Informes, tendencias y próximas actuaciones alimentan la mejora continua.</p>
        <div class="story-tags"><span>Informe</span><span>Tendencia</span><span>Preventivo</span></div>
      </article>
    </div>

    <div class="story-stage-wrap" aria-live="polite">
      <div class="story-stage" data-story-stage>
        <div class="story-glow"></div>
        <div class="story-stage-top">
          <div>
            <small>IsiVoltPro Flow</small>
            <strong data-story-title>Aviso recibido</strong>
          </div>
          <span class="story-status"><i></i><b data-story-status>Nueva incidencia</b></span>
        </div>

        <div class="story-progress" aria-hidden="true"><span data-story-progress></span></div>

        <div class="story-scenes">
          <div class="story-scene is-active" data-story-scene="0">
            <div class="scene-map">
              <div class="map-lines"></div>
              <span class="map-pin pin-one"></span><span class="map-pin pin-two"></span>
              <div class="scene-location"><small>Ubicación detectada</small><strong>Planta 2 · Zona quirúrgica</strong></div>
            </div>
            <div class="scene-cards">
              <article><small>Prioridad</small><strong>Alta</strong><em>Atención inmediata</em></article>
              <article><small>Adjuntos</small><strong>3</strong><em>Fotos del aviso</em></article>
            </div>
          </div>

          <div class="story-scene" data-story-scene="1">
            <div class="assign-grid">
              <article class="assign-main"><small>Equipo recomendado</small><strong>Electricidad</strong><span>2 técnicos disponibles</span><div class="avatar-row"><i>AZ</i><i>JM</i><i>+</i></div></article>
              <article><small>Tiempo estimado</small><strong>45 min</strong></article>
              <article><small>Material preparado</small><strong>4 uds.</strong></article>
            </div>
            <div class="schedule-bars"><i style="--w:78%"></i><i style="--w:56%"></i><i style="--w:88%"></i></div>
          </div>

          <div class="story-scene" data-story-scene="2">
            <div class="asset-phone">
              <div class="asset-phone-top"><span>09:42</span><b>IsiVoltPro</b></div>
              <div class="scan-frame"><i></i><span>QR</span></div>
              <strong>UTA-03</strong><small>Cubierta técnica</small>
            </div>
            <div class="asset-history">
              <small>Historial del activo</small>
              <div><i></i><span><b>Hoy</b> Revisión en curso</span></div>
              <div><i></i><span><b>15 jun</b> Sustitución de filtros</span></div>
              <div><i></i><span><b>02 may</b> Inspección preventiva</span></div>
            </div>
          </div>

          <div class="story-scene" data-story-scene="3">
            <div class="verify-head"><span>Checklist de intervención</span><b>4/5</b></div>
            <div class="verify-list"><div class="done"><i>✓</i><span>Consignación y seguridad</span></div><div class="done"><i>✓</i><span>Inspección visual</span></div><div class="done"><i>✓</i><span>Medición eléctrica</span></div><div class="done"><i>✓</i><span>Fotografías finales</span></div><div><i></i><span>Firma y cierre</span></div></div>
            <div class="verify-meter"><small>Valor registrado</small><strong>28,4 MΩ</strong><span>Correcto</span></div>
          </div>

          <div class="story-scene" data-story-scene="4">
            <div class="report-sheet">
              <div class="report-head"><span>INFORME TÉCNICO</span><b>PDF</b></div>
              <div class="report-lines"><i></i><i></i><i></i><i></i></div>
              <div class="report-chart"><span style="--h:42%"></span><span style="--h:63%"></span><span style="--h:51%"></span><span style="--h:78%"></span><span style="--h:91%"></span></div>
            </div>
            <div class="report-insight"><small>Próxima actuación</small><strong>Preventivo en 90 días</strong><p>Creado a partir del historial y la intervención cerrada.</p></div>
          </div>
        </div>

        <div class="story-stage-footer"><span data-story-counter>01 / 05</span><small>Desplázate para continuar</small></div>
      </div>
    </div>
  </div>
</section>

<script>
  const stories = document.querySelectorAll('[data-story]');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  stories.forEach((story) => {
    const steps = [...story.querySelectorAll('[data-story-step]')];
    const scenes = [...story.querySelectorAll('[data-story-scene]')];
    const title = story.querySelector('[data-story-title]');
    const status = story.querySelector('[data-story-status]');
    const progress = story.querySelector('[data-story-progress]');
    const counter = story.querySelector('[data-story-counter]');
    const stage = story.querySelector('[data-story-stage]');
    const labels = [
      ['Aviso recibido', 'Nueva incidencia'],
      ['Orden coordinada', 'Equipo asignado'],
      ['Activo identificado', 'Trabajo en campo'],
      ['Intervención verificada', 'Evidencias completas'],
      ['Conocimiento generado', 'Informe preparado']
    ];

    const activate = (index) => {
      steps.forEach((step, i) => step.classList.toggle('is-active', i === index));
      scenes.forEach((scene, i) => scene.classList.toggle('is-active', i === index));
      if (title) title.textContent = labels[index][0];
      if (status) status.textContent = labels[index][1];
      if (progress) progress.style.width = `${((index + 1) / steps.length) * 100}%`;
      if (counter) counter.textContent = `${String(index + 1).padStart(2, '0')} / ${String(steps.length).padStart(2, '0')}`;
      stage?.setAttribute('data-active', String(index));
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) activate(Number(entry.target.getAttribute('data-story-step')));
      });
    }, { rootMargin: '-38% 0px -42% 0px', threshold: 0 });

    steps.forEach((step) => observer.observe(step));

    if (!reduceMotion && stage) {
      let ticking = false;
      const move = () => {
        const rect = story.getBoundingClientRect();
        const progressValue = Math.max(0, Math.min(1, -rect.top / Math.max(1, rect.height - innerHeight)));
        stage.style.setProperty('--story-shift', `${(progressValue - .5) * 18}px`);
        ticking = false;
      };
      addEventListener('scroll', () => {
        if (!ticking) {
          requestAnimationFrame(move);
          ticking = true;
        }
      }, { passive: true });
      move();
    }
  });
</script>
