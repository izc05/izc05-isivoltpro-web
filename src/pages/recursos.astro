---
import PageLayout from '../layouts/PageLayout.astro';
import { resourceArticles } from '../data/resources';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const withBase = (href: string) => href === '/' ? base : `${base}${href.replace(/^\/+/, '')}`;
---

<PageLayout title="Centro de conocimiento" description="Artículos, guías y recursos técnicos de mantenimiento en IsiVoltPro.">
  <section class="page-hero resources-hero">
    <div class="container page-hero-grid">
      <div class="reveal">
        <span class="page-kicker">Información técnica útil</span>
        <h1>Centro de <span class="accent">conocimiento</span></h1>
        <p class="lead">IsiVoltPro no es solamente un catálogo de aplicaciones. Este espacio reúne explicaciones, guías, casos prácticos y recursos para profesionales del mantenimiento y las instalaciones.</p>
        <div class="hero-actions"><a class="button button-primary" href="#recursos">Explorar recursos →</a><a class="button button-secondary" href={withBase('/ecosistema')}>Ver ecosistema</a></div>
      </div>
      <div class="page-visual reveal">
        <div class="page-visual-grid">
          <div class="page-visual-card"><span>Guías</span><strong>Procesos explicados paso a paso</strong></div>
          <div class="page-visual-card"><span>Normativa</span><strong>Información técnica ordenada</strong></div>
          <div class="page-visual-card"><span>Casos</span><strong>Problemas reales y soluciones</strong></div>
          <div class="page-visual-card"><span>Plantillas</span><strong>Recursos listos para trabajar</strong></div>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="recursos">
    <div class="container">
      <div class="catalog-toolbar reveal"><div><p class="eyebrow">Primeras líneas editoriales</p><h2>Aprender para mantener mejor</h2></div><p class="lead">Cada recurso parte de un problema técnico concreto y organiza el contexto, las comprobaciones y las conclusiones para que la información sea fácil de reutilizar.</p></div>
      <div class="resource-grid">
        {resourceArticles.map((resource) => (
          <article class="resource-card reveal">
            <div class="resource-card-top"><span class="tag">{resource.category}</span><span>{resource.readTime}</span></div>
            <h3>{resource.title}</h3>
            <p>{resource.summary}</p>
            <a class="card-link" href={withBase(`/recursos/${resource.slug}`)}>Leer recurso →</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-soft">
    <div class="container content-split">
      <div class="content-sticky reveal"><p class="eyebrow">Contenido fiable</p><h2>La IA puede ayudar, pero el criterio técnico es la base</h2><p class="lead">Los textos deben ser comprensibles, verificables y útiles para la práctica profesional.</p></div>
      <div class="feature-list">
        <article class="feature-row reveal"><span>Fuentes</span><h3>Normativa y documentación identificadas</h3><p>Las referencias importantes se incorporan de forma visible a medida que cada recurso completa su revisión especializada.</p></article>
        <article class="feature-row reveal"><span>Fecha</span><h3>Contenido con vigencia clara</h3><p>Cada recurso muestra cuándo fue revisado para que su contexto temporal sea visible.</p></article>
        <article class="feature-row reveal"><span>Aplicación</span><h3>De la explicación a la herramienta</h3><p>Cuando existe una aplicación relacionada, el artículo permite saltar directamente a su ficha dentro del ecosistema.</p></article>
      </div>
    </div>
  </section>
</PageLayout>
