---
import PageLayout from '../layouts/PageLayout.astro';
import AppDeviceVisual from '../components/AppDeviceVisual.astro';
import EcosystemRoadmap from '../components/EcosystemRoadmap.astro';
import EcosystemArchitectureExplorer from '../components/EcosystemArchitectureExplorer.astro';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const withBase = (href: string) => href === '/' ? base : `${base}${href.replace(/^\/+/, '')}`;

const flow = [
  { title: 'Identificar', icon: '01', text: 'Cliente, instalación, ubicación y activo crean el contexto físico sobre el que trabaja todo el ecosistema.' },
  { title: 'Conectar', icon: '02', text: 'QR/NFC, documentos, personas y datos quedan relacionados con el elemento correcto sin duplicar información.' },
  { title: 'Ejecutar', icon: '03', text: 'OT, mantenimiento, herramientas, inventario e inspecciones utilizan ese contexto durante el trabajo diario.' },
  { title: 'Verificar', icon: '04', text: 'Fotografías, mediciones, checklist, materiales, firmas y resultados dejan evidencia de lo realizado.' },
  { title: 'Reutilizar', icon: '05', text: 'El histórico vuelve al activo y queda disponible para la siguiente intervención, revisión o decisión.' }
];

const benefits = [
  { icon: '▤', title: 'Dato único', text: 'La información esencial se registra una vez y puede reutilizarse donde aporta valor.' },
  { icon: '✓', title: 'Trazabilidad total', text: 'Activos, órdenes, tareas y movimientos conservan su contexto e histórico.' },
  { icon: '↗', title: 'Menos trabajo repetido', text: 'Evita reconstruir después información que ya existía durante la intervención.' },
  { icon: '▯', title: 'Trabajo de campo', text: 'La información acompaña al técnico mediante experiencias adaptadas a móvil.' },
  { icon: '◉', title: 'Visibilidad operativa', text: 'Coordinación y responsables pueden seguir el estado real del trabajo.' },
  { icon: '◇', title: 'Crecimiento modular', text: 'Cada aplicación puede avanzar por separado y conectarse cuando sea útil.' }
];
---

<PageLayout title="Ecosistema conectado para el mantenimiento técnico" description="IsiVoltPro conecta clientes, instalaciones, activos, personas, órdenes, herramientas, inspecciones, documentación y especialidades técnicas en una arquitectura modular.">
  <EcosystemArchitectureExplorer />

  <section class="pv12-section is-soft">
    <div class="container">
      <div class="pv12-section-head" data-premium-reveal>
        <p class="eyebrow">Cómo circula el contexto</p>
        <h2>La información acompaña al trabajo de principio a fin</h2>
        <p>IsiVoltPro no pretende meter todo en una única pantalla. La plataforma conserva una base común y permite que cada aplicación utilice solo el contexto que necesita.</p>
      </div>
      <div class="pv12-flow-grid">
        {flow.map((item,index)=><article class="pv12-flow-card" data-premium-reveal style={`transition-delay:${index*70}ms`}><b>{item.icon}</b><h3>{item.title}</h3><p>{item.text}</p></article>)}
      </div>
    </div>
  </section>

  <section class="pv12-section">
    <div class="container">
      <div class="pv12-section-head" data-premium-reveal>
        <p class="eyebrow">Arquitectura pensada para mantenimiento</p>
        <h2>Conectar no significa complicar</h2>
        <p>Cada módulo debe resolver bien su trabajo y compartir datos solo cuando eso reduce errores, mejora trazabilidad o evita tareas repetidas.</p>
      </div>
      <div class="pv12-benefit-grid">
        {benefits.map((item,index)=><article class="pv12-benefit-card" data-premium-reveal style={`transition-delay:${index*55}ms`}><i>{item.icon}</i><h3>{item.title}</h3><p>{item.text}</p></article>)}
      </div>
    </div>
  </section>

  <section class="pv12-section" style="padding-top:0">
    <div class="container">
      <div class="pv12-eco-highlight" data-premium-reveal>
        <div class="pv12-eco-highlight-copy">
          <p class="eyebrow" style="color:#5fe0ef">Aplicaciones operativas</p>
          <h2>El ecosistema ya tiene piezas reales funcionando</h2>
          <p>Herramientas QR/NFC e IsiVoltPro OT son las primeras aplicaciones publicadas. Sirven como base para validar el enfoque modular antes de incorporar nuevas especialidades.</p>
          <ul class="pv12-feature-list">
            <li>Herramientas: inventario, técnicos, préstamos y devoluciones</li>
            <li>Identificación y trazabilidad mediante QR/NFC</li>
            <li>OT: clientes, instalaciones, asignación y estados</li>
            <li>Zona móvil para técnicos y seguimiento cronológico</li>
            <li>Base común preparada para activos y mantenimiento</li>
            <li>Evolución independiente sin perder la identidad IsiVoltPro</li>
          </ul>
          <div class="pv12-hero-actions">
            <a class="button button-dark" href={withBase('/aplicaciones')}>Explorar aplicaciones →</a>
            <a class="button button-secondary" href={withBase('/mantenimiento')}>Ver mantenimiento conectado</a>
          </div>
        </div>
        <AppDeviceVisual compact={true} showMetrics={false} label="Aplicaciones operativas y demostrativas de IsiVoltPro" />
      </div>
    </div>
  </section>

  <section class="pv12-section is-soft">
    <div class="container">
      <EcosystemRoadmap title="Dos aplicaciones operativas. Una arquitectura preparada para crecer." />
    </div>
  </section>

  <section class="pv12-section">
    <div class="container">
      <div class="pv12-final-cta" data-premium-reveal>
        <span class="pv12-final-cta-icon">↗</span>
        <div>
          <p class="eyebrow">IsiVoltPro crece por capas</p>
          <h2>Empieza por una necesidad real. Conecta después.</h2>
          <p>Una empresa puede comenzar con herramientas, OT, activos o una especialidad concreta y ampliar el ecosistema sin rehacer todo desde cero.</p>
        </div>
        <a class="button button-primary" href={withBase('/contacto')}>Plantear una instalación</a>
      </div>
    </div>
  </section>
</PageLayout>
