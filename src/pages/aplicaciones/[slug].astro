---
import PageLayout from '../../layouts/PageLayout.astro';
import ToolsProductShowcase from '../../components/ToolsProductShowcase.astro';
import { ecosystemAreas, type EcosystemArea } from '../../data/catalog';

export function getStaticPaths() {
  return ecosystemAreas.map((area) => ({ params: { slug: area.slug }, props: { area } }));
}

interface Props { area: EcosystemArea; }
const { area } = Astro.props;
const isNextRelease = area.slug === 'mantenimiento-ot';
const isInspection = area.slug === 'inspecciones-bt';
const isToolsProduct = area.slug === 'herramientas-maletines';

const workflow = isNextRelease
  ? [
      ['01 · Aviso', 'Recibir el problema con contexto', 'Cliente, instalación, ubicación, prioridad, instrucciones de acceso, descripción y fotografías desde el primer registro.'],
      ['02 · Coordinar', 'Asignar y hacer seguimiento', 'Administración y coordinación comparten estados, técnico responsable, próxima actuación, materiales y trazabilidad.'],
      ['03 · Intervenir', 'Trabajar desde el móvil', 'El técnico acepta, inicia, consulta información, registra materiales, completa checklist y añade evidencias sin perder el contexto.'],
      ['04 · Cerrar', 'Documentar el resultado', 'Resultado, observaciones, fotografías, firma, informe y auditoría cronológica quedan vinculados a la orden.']
    ]
  : isInspection
    ? [
        ['01 · Datos', 'Identificar la instalación', 'Tipo de inspección, reglamento aplicable, titular, emplazamiento, características y documentación disponible.'],
        ['02 · Revisión', 'Trabajar por bloques', 'Unifilar, protecciones, puesta a tierra, locales especiales, checklist y puntos de inspección ordenados.'],
        ['03 · Campo', 'Registrar mediciones y defectos', 'Valores medidos, observaciones, clasificación de defectos y evidencias fotográficas desde móvil o tableta.'],
        ['04 · Informe', 'Construir el resultado final', 'Resumen de defectos, conclusión, fotografías, mediciones e informe profesional preparado para revisar y exportar.']
      ]
    : [
        ['01 · Descubrir', 'Entender el trabajo actual', 'Analizamos quién utiliza la herramienta, dónde trabaja, qué información necesita y qué errores queremos evitar.'],
        ['02 · Simplificar', 'Diseñar el flujo mínimo', 'El objetivo no es digitalizar formularios complicados, sino reducir pasos y hacer más clara cada decisión.'],
        ['03 · Validar', 'Probar antes de ampliar', 'Primero se construye un recorrido completo y útil. Después se añaden automatizaciones, informes e integraciones.'],
        ['04 · Conectar', 'Integrarse con el ecosistema', 'Cuando aporte valor, podrá compartir técnicos, ubicaciones, activos, documentos y permisos con otros módulos IsiVoltPro.']
      ];
---

<PageLayout title={area.name} description={area.description}>
  {isToolsProduct ? (
    <ToolsProductShowcase area={area} />
  ) : (
    <>
      <section class="detail-hero">
        <div class="container detail-grid">
          <div class="reveal">
            <span class="page-kicker">{area.code} · Ecosistema IsiVoltPro</span>
            <h1>{area.name}</h1>
            <p class="lead">{area.description}</p>
            <div class="detail-meta"><span class="detail-chip">Estado: {area.status}</span><span class="detail-chip">Para: {area.audience}</span></div>
            <div class="hero-actions">
              <a class="button button-primary" href="/contacto">{isNextRelease ? 'Seguir la próxima publicación →' : 'Seguir su desarrollo →'}</a>
              <a class="button button-secondary" href="/aplicaciones">Volver al catálogo</a>
            </div>
          </div>
          <aside class="detail-panel reveal"><p class="eyebrow">Funciones principales</p><h2>Diseñada para resolver tareas concretas</h2><ul>{area.highlights.map((highlight) => <li>{highlight}</li>)}</ul></aside>
        </div>
      </section>

      <section class="section">
        <div class="container content-split">
          <div class="content-sticky reveal">
            <p class="eyebrow">{isNextRelease || isInspection ? 'Flujo de trabajo' : 'Enfoque de producto'}</p>
            <h2>{isNextRelease ? 'De la incidencia al cierre documentado' : isInspection ? 'De los datos de la instalación al informe' : 'Del problema técnico a una herramienta sencilla'}</h2>
            <p class="lead">{isNextRelease
              ? 'OT será la siguiente aplicación que se publicará. Conectará avisos, coordinación, técnicos, evidencias y cierre sin perder el contexto de la intervención.'
              : isInspection
                ? 'La inspección se divide en pasos claros para evitar omisiones y convertir el trabajo de campo en un informe coherente.'
                : 'La aplicación se construirá a partir de situaciones reales, reduciendo pasos y mostrando solamente la información necesaria en cada momento.'}</p>
          </div>
          <div class="feature-list">{workflow.map((step) => <article class="feature-row reveal"><span>{step[0]}</span><h3>{step[1]}</h3><p>{step[2]}</p></article>)}</div>
        </div>
      </section>

      <section class="section section-soft">
        <div class="container">
          <div class="cta reveal">
            <div><h2>{isNextRelease ? 'IsiVoltPro OT será la siguiente pieza publicada' : 'Esta herramienta forma parte del roadmap'}</h2><p>{isNextRelease ? 'La base funcional ya existe y continuará evolucionando antes de abrir su publicación: zona móvil, evidencias, informes, permisos e integración con Herramientas QR/NFC.' : 'El catálogo crecerá de forma progresiva, manteniendo una experiencia común y una arquitectura ordenada.'}</p></div>
            <a class="button button-dark" href={isNextRelease ? '/contacto' : '/ecosistema'}>{isNextRelease ? 'Conocer el avance de OT →' : 'Explorar ecosistema →'}</a>
          </div>
        </div>
      </section>
    </>
  )}
</PageLayout>