---
import PageLayout from '../../layouts/PageLayout.astro';
import ToolsProductShowcase from '../../components/ToolsProductShowcase.astro';
import OtProductShowcase from '../../components/OtProductShowcase.astro';
import BtProductShowcase from '../../components/BtProductShowcase.astro';
import RoadmapProductShowcase from '../../components/RoadmapProductShowcase.astro';
import { ecosystemAreas, type EcosystemArea } from '../../data/catalog';

export function getStaticPaths() {
  return ecosystemAreas.map((area) => ({ params: { slug: area.slug }, props: { area } }));
}

interface Props { area: EcosystemArea; }
const { area } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const siteRoot = new URL(base, Astro.site);
const pageUrl = new URL(`aplicaciones/${area.slug}/`, siteRoot).toString();
const isOperationalOT = area.slug === 'mantenimiento-ot';
const isToolsProduct = area.slug === 'herramientas-maletines';
const isBtProduct = area.slug === 'inspecciones-bt';
const structuredData = {
  '@type': 'SoftwareApplication',
  name: area.name,
  description: area.description,
  applicationCategory: area.family,
  operatingSystem: 'Web',
  url: pageUrl,
  publisher: { '@id': `${siteRoot.toString()}#organization` }
};
---

<PageLayout title={area.name} description={area.description} structuredData={structuredData}>
  {isToolsProduct ? (
    <ToolsProductShowcase area={area} />
  ) : isOperationalOT ? (
    <OtProductShowcase />
  ) : isBtProduct ? (
    <BtProductShowcase />
  ) : (
    <RoadmapProductShowcase area={area} />
  )}
</PageLayout>
