---
import '../styles/global.css';
import '../styles/pages.css';
import '../styles/visual.css';
import '../styles/home-v2.css';
import '../styles/sticky-story.css';
import '../styles/brand-refinements.css';
import '../styles/real-media.css';
import '../styles/premium-v2.css';
import '../styles/cinematic-v3.css';
import Header from '../components/Header.astro';
import RealHeroMedia from '../components/RealHeroMedia.astro';
import CinematicRail from '../components/CinematicRail.astro';
import DailyWorkflow from '../components/DailyWorkflow.astro';
import EcosystemMap from '../components/EcosystemMap.astro';
import StickyStory from '../components/StickyStory.astro';
import VisualShowcase from '../components/VisualShowcase.astro';
import FieldPrinciples from '../components/FieldPrinciples.astro';
import SectorStories from '../components/SectorStories.astro';
import OverviewSections from '../components/OverviewSections.astro';
import ProductSections from '../components/ProductSections.astro';
import Footer from '../components/Footer.astro';
import { brand } from '../data/brand';

const description = brand.description;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const canonical = new URL(base, Astro.site);
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: brand.name,
  url: canonical.toString(),
  description,
  publisher: {
    '@type': 'Organization',
    name: brand.name,
    email: brand.email
  }
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#071a33" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content={brand.name} />
    <meta property="og:title" content="IsiVoltPro · Mantenimiento conectado de principio a fin" />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>IsiVoltPro · Mantenimiento conectado de principio a fin</title>
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <Header />
    <main id="contenido">
      <section class="hero hero-real" id="inicio">
        <div class="container hero-grid">
          <div class="hero-copy reveal">
            <p class="eyebrow">Tecnología para instalaciones que no pueden parar</p>
            <h1>
              <span class="hero-title-line">Del aviso al informe.</span>
              <span class="hero-title-line">El mantenimiento</span>
              <span class="hero-title-line"><span class="accent">más claro.</span></span>
            </h1>
            <p class="lead">Órdenes de trabajo, técnicos, activos, inventario, inspecciones y evidencias. Todo conectado para que oficina y campo trabajen con la misma información.</p>
            <div class="hero-actions">
              <a class="button button-primary" href="/ecosistema">Explorar el ecosistema →</a>
              <a class="button button-secondary" href="/aplicaciones/mantenimiento-ot">Ver IsiVoltPro OT</a>
            </div>
            <div class="hero-points">
              <div class="hero-point"><b>OT</b>Avisos y trabajos</div>
              <div class="hero-point"><b>QR</b>Activos e historial</div>
              <div class="hero-point"><b>MAT</b>Material utilizado</div>
              <div class="hero-point"><b>DOC</b>Cierre e informe</div>
            </div>
            <p class="hero-domain"><i></i>{brand.domain}</p>
          </div>
          <RealHeroMedia />
        </div>
      </section>

      <div class="sector-ribbon" aria-label="Ámbitos de aplicación">
        <div class="container sector-ribbon-inner">
          <span>Hospitales</span><i></i><span>Industria</span><i></i><span>Edificios</span><i></i><span>Servicios técnicos</span><i></i><span>Instalaciones</span>
        </div>
      </div>

      <CinematicRail />
      <DailyWorkflow />
      <EcosystemMap />
      <StickyStory />
      <SectorStories />
      <VisualShowcase />
      <FieldPrinciples />
      <OverviewSections />
      <ProductSections />
    </main>
    <Footer />

    <script is:inline>
      const toggle = document.querySelector('.menu-toggle');
      const nav = document.querySelector('.nav-links');
      toggle?.addEventListener('click', () => {
        const open = nav?.classList.toggle('open');
        toggle.setAttribute('aria-expanded', String(Boolean(open)));
      });
      nav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => {
        nav.classList.remove('open');
        toggle?.setAttribute('aria-expanded', 'false');
      }));

      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.12 });
      document.querySelectorAll('.reveal').forEach((element) => observer.observe(element));
    </script>
  </body>
</html>
