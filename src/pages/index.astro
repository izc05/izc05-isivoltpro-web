---
import '../styles/global.css';
import '../styles/pages.css';
import '../styles/privacy-security-polish.css';
import '../styles/production-readiness-v10-3.css';
import '../styles/premium-redesign-v12.css';
import '../styles/experience-v13.css';
import '../styles/mobile-ot-v14.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PrivacyCenter from '../components/PrivacyCenter.astro';
import PremiumMotion from '../components/PremiumMotion.astro';
import AppDeviceVisual from '../components/AppDeviceVisual.astro';
import EcosystemRoadmap from '../components/EcosystemRoadmap.astro';
import HomeOtSpotlight from '../components/HomeOtSpotlight.astro';
import { brand } from '../data/brand';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const withBase = (href: string) => href === '/' ? base : `${base}${href.replace(/^\/+/, '')}`;
const canonical = new URL(base, Astro.site);
const description = 'IsiVoltPro conecta mantenimiento, técnicos, herramientas, activos e inspecciones en un ecosistema digital profesional.';

const solutions = [
  { icon: '▣', title: 'Mantenimiento preventivo', text: 'Planifica tareas periódicas, vencimientos y evidencias para alargar la vida útil de las instalaciones.' },
  { icon: '⌕', title: 'Mantenimiento correctivo', text: 'Gestiona incidencias, responsables, tiempos y cierres con un historial claro y verificable.' },
  { icon: '✓', title: 'Inspecciones y auditorías', text: 'Crea checklists, mediciones, fotografías, firmas e informes técnicos desde campo.' },
  { icon: '◇', title: 'Gestión de activos', text: 'Identifica herramientas, equipos e instalaciones mediante QR/NFC y consulta su contexto.' }
];

const workflow = [
  { icon: '⌕', title: 'Detectar', text: 'Identificamos necesidades, evaluamos instalaciones y capturamos los datos importantes.' },
  { icon: '⚙', title: 'Gestionar', text: 'Organizamos tareas, técnicos y recursos con control y trazabilidad.' },
  { icon: '↗', title: 'Optimizar', text: 'Analizamos resultados para reducir tiempos, pérdidas y trabajo repetido.' },
  { icon: '◎', title: 'Evolucionar', text: 'Conectamos nuevas aplicaciones sin perder la información ya creada.' }
];

const applications = [
  { icon: '▣', name: 'Herramientas QR/NFC', copy: 'Inventario, préstamos y trazabilidad.', status: 'Operativa', live: true, href: '/aplicaciones/herramientas-maletines' },
  { icon: '⌑', name: 'IsiVoltPro OT', copy: 'Clientes, instalaciones, órdenes, técnicos y auditoría.', status: 'Operativa', live: true, href: '/aplicaciones/mantenimiento-ot' },
  { icon: '✓', name: 'Inspecciones BT', copy: 'Mediciones, defectos e informes.', status: 'En desarrollo', href: '/aplicaciones/inspecciones-bt' },
  { icon: '▤', name: 'RITE', copy: 'Instalaciones térmicas y climatización.', status: 'Planificado', href: '/aplicaciones/climatizacion-rite' },
  { icon: '♨', name: 'PCI', copy: 'Equipos, revisiones y mantenimientos.', status: 'Planificado', href: '/aplicaciones/pci' },
  { icon: '◯', name: 'Legionella', copy: 'Controles, muestras y registros.', status: 'Planificado', href: '/aplicaciones/legionella-agua' }
];

const resources = [
  { art: '🏥', title: 'Mantenimiento hospitalario: continuidad y trazabilidad', meta: 'Mantenimiento' },
  { art: '▥', title: 'Digitalización: del papel a una operación conectada', meta: 'Transformación digital' },
  { art: '⚡', title: 'Cuadros eléctricos: revisión y puntos críticos', meta: 'Instalaciones' },
  { art: '❄', title: 'RITE: qué revisar en instalaciones térmicas', meta: 'Climatización' },
  { art: '✓', title: 'Checklists digitales: menos errores y más control', meta: 'Buenas prácticas' }
];

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: brand.name,
  url: canonical.toString(),
  description,
  publisher: { '@type': 'Organization', name: brand.name, email: brand.email, slogan: brand.claim }
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#071a33" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content={brand.name} />
    <meta property="og:title" content="IsiVoltPro · Mantenimiento inteligente y aplicaciones técnicas" />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>IsiVoltPro · Mantenimiento inteligente y aplicaciones técnicas</title>
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <Header />

    <main id="contenido">
      <section class="pv12-home-hero" id="inicio">
        <div class="pv13-hero-ambient" aria-hidden="true">
          <span class="pv13-grid-lines"></span>
          <span class="pv13-orb pv13-orb-one"></span>
          <span class="pv13-orb pv13-orb-two"></span>
          <span class="pv13-orb pv13-orb-three"></span>
          <span class="pv13-signal pv13-signal-one"></span>
          <span class="pv13-signal pv13-signal-two"></span>
        </div>
        <div class="container pv12-home-grid">
          <div class="pv12-home-copy" data-premium-reveal>
            <p class="eyebrow">Ecosistema para el mantenimiento técnico</p>
            <h1>Mantenimiento inteligente y aplicaciones digitales para el <span class="accent">trabajo técnico</span></h1>
            <p class="lead">Digitalizamos procesos, conectamos equipos y damos a técnicos y responsables herramientas potentes, sencillas y seguras. Todo el mantenimiento, en un solo ecosistema.</p>
            <div class="pv12-hero-actions">
              <a class="button button-primary" href={withBase('/mantenimiento')}>Ver soluciones →</a>
              <a class="button button-secondary" href={withBase('/aplicaciones')}>Explorar aplicaciones</a>
            </div>
            <div class="pv13-live-apps" aria-label="Aplicaciones operativas">
              <a class="pv13-live-app" href={withBase('/aplicaciones/herramientas-maletines')}><i aria-hidden="true"></i><span>Herramientas QR/NFC</span><strong>Operativa</strong></a>
              <a class="pv13-live-app" href={withBase('/aplicaciones/mantenimiento-ot')}><i aria-hidden="true"></i><span>IsiVoltPro OT</span><strong>Operativa</strong></a>
            </div>
          </div>

          <div class="pv14-hero-visual" data-premium-reveal>
            <AppDeviceVisual />
          </div>

          <div class="pv12-trust-row" aria-label="Ventajas principales" data-premium-reveal>
            <div class="pv12-trust-item"><span class="pv12-trust-icon">◇</span><span>Datos seguros<br />y bajo tu control</span></div>
            <div class="pv12-trust-item"><span class="pv12-trust-icon">☁</span><span>Funciona online<br />y offline</span></div>
            <div class="pv12-trust-item"><span class="pv12-trust-icon">▯</span><span>Apps móviles<br />para técnicos</span></div>
            <div class="pv12-trust-item"><span class="pv12-trust-icon">▥</span><span>Información en<br />tiempo real</span></div>
          </div>
        </div>
      </section>

      <HomeOtSpotlight />

      <section class="pv12-section is-soft">
        <div class="container">
          <div class="pv12-section-head" data-premium-reveal><h2>Todo el mantenimiento en un solo ecosistema</h2></div>
          <div class="pv12-solution-grid">
            {solutions.map((item, index) => (
              <article class="pv12-solution-card" data-premium-reveal style={`transition-delay:${index * 70}ms`}>
                <span class="pv12-card-icon">{item.icon}</span><h3>{item.title}</h3><p>{item.text}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="pv12-section">
        <div class="container">
          <div class="pv12-section-head" data-premium-reveal><h2>Cómo trabajamos</h2></div>
          <div class="pv12-workflow">
            {workflow.map((item, index) => (
              <article class="pv12-workflow-item" data-premium-reveal style={`transition-delay:${index * 90}ms`}>
                <span class="pv12-workflow-number">{index + 1}</span><span class="pv12-workflow-icon">{item.icon}</span><div><h3>{item.title}</h3><p>{item.text}</p></div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="pv12-section" style="padding-top:0">
        <div class="container">
          <div class="pv12-feature-band" data-premium-reveal>
            <div class="pv12-feature-copy">
              <span class="pv12-feature-label">Aplicación operativa</span>
              <h2>Herramientas QR/NFC</h2>
              <p>La aplicación real de IsiVoltPro para inventario, responsables, préstamos, devoluciones, etiquetas e historial completo.</p>
              <ul class="pv12-feature-list">
                <li>Inventario de herramientas y equipos</li><li>Identificación mediante QR y NFC</li><li>Asignación a técnicos y responsables</li><li>Historial y auditoría de movimientos</li><li>Préstamos y devoluciones controladas</li><li>Base preparada para conectar con OT</li>
              </ul>
              <a class="button button-dark" href={withBase('/aplicaciones/herramientas-maletines')}>Explorar Herramientas QR/NFC →</a>
            </div>
            <div class="pv12-feature-visual"><AppDeviceVisual compact={true} showMetrics={false} /></div>
          </div>
        </div>
      </section>

      <section class="pv12-section is-soft"><div class="container"><EcosystemRoadmap /></div></section>

      <section class="pv12-section">
        <div class="container">
          <div class="pv12-section-head" data-premium-reveal>
            <h2>Aplicaciones que forman el ecosistema</h2>
            <p>Herramientas QR/NFC e IsiVoltPro OT ya están operativas. El resto del ecosistema crecerá por especialidades conectadas.</p>
          </div>
          <div class="pv12-app-grid">
            {applications.map((app, index) => (
              <a class:list={['pv12-app-card', app.live && 'is-live', app.live && 'is-operational']} href={withBase(app.href)} data-premium-reveal style={`transition-delay:${index * 55}ms`}>
                <span class="pv12-app-icon">{app.icon}</span><h3>{app.name}</h3><p>{app.copy}</p><span class:list={['pv12-app-status', app.live && 'is-live', app.live && 'is-operational']}>{app.status}</span>
              </a>
            ))}
          </div>
        </div>
      </section>

      <section class="pv12-section is-soft">
        <div class="container">
          <div class="pv12-section-head" data-premium-reveal><h2>Novedades y recursos</h2><p>Contenido técnico para acompañar la digitalización del mantenimiento y las instalaciones.</p></div>
          <div class="pv12-resource-grid">
            {resources.map((resource, index) => (
              <a class="pv12-resource-card" href={withBase('/recursos')} data-premium-reveal style={`transition-delay:${index * 55}ms`}>
                <div class="pv12-resource-art">{resource.art}</div><div class="pv12-resource-body"><h3>{resource.title}</h3><p>{resource.meta}</p></div>
              </a>
            ))}
          </div>
        </div>
      </section>

      <section class="pv12-section" style="padding-top:0">
        <div class="container">
          <div class="pv12-server-banner" data-premium-reveal>
            <span class="pv12-server-icon">▤</span><div><h2>Tu información, en tu servidor y tu dominio</h2><p>IsiVoltPro está preparado para funcionar en infraestructura propia, con control de acceso, copias y publicación segura.</p></div><a class="button button-primary" href={withBase('/contacto')}>Solicitar demo</a>
          </div>
        </div>
      </section>
    </main>

    <Footer /><PrivacyCenter /><PremiumMotion />

    <script is:inline>
      const toggle = document.querySelector('.menu-toggle');
      const nav = document.querySelector('.nav-links');
      toggle?.addEventListener('click', () => { const open = nav?.classList.toggle('open'); toggle.setAttribute('aria-expanded', String(Boolean(open))); });
      nav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => { nav.classList.remove('open'); toggle?.setAttribute('aria-expanded', 'false'); }));
    </script>
  </body>
</html>
