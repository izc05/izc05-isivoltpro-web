---
import PageLayout from '../layouts/PageLayout.astro';
import MaintenanceCommandCenter from '../components/MaintenanceCommandCenter.astro';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const withBase = (href: string) => href === '/' ? base : `${base}${href.replace(/^\/+/, '')}`;
---

<PageLayout
  title="Mantenimiento conectado"
  description="IsiVoltPro conecta correctivos, preventivos, revisiones, técnicos, activos, materiales, evidencias e histórico en una operación de mantenimiento trazable."
>
  <MaintenanceCommandCenter />

  <section class="section">
    <div class="container">
      <div class="section-heading reveal">
        <p class="eyebrow">Un único contexto · distintas responsabilidades</p>
        <h2>Cada persona ve lo que necesita, pero trabaja sobre la misma realidad</h2>
        <p class="lead">Administración, coordinación y técnicos no necesitan la misma interfaz. Sí necesitan compartir la misma orden, instalación, activo e histórico.</p>
      </div>
      <div class="role-grid">
        <article class="role-card reveal"><span>01</span><h3>Administración</h3><p>Recoge el aviso y deja preparado el contexto inicial para que no tenga que reconstruirse después.</p><ul><li>Cliente e instalación</li><li>Contacto, ubicación y acceso</li><li>Descripción y evidencias iniciales</li></ul></article>
        <article class="role-card reveal"><span>02</span><h3>Coordinación</h3><p>Convierte la necesidad en trabajo organizado, visible y priorizado.</p><ul><li>Prioridad y asignación</li><li>Agenda, bloqueos y especialidad</li><li>Seguimiento del estado real</li></ul></article>
        <article class="role-card reveal"><span>03</span><h3>Técnico de campo</h3><p>Recibe una experiencia móvil centrada en ejecutar, registrar y verificar.</p><ul><li>Aceptar e iniciar trabajo</li><li>QR/NFC, activo e histórico</li><li>Fotos, material, checklist y cierre</li></ul></article>
      </div>
    </div>
  </section>

  <section class="section section-dark operations-flow-section">
    <div class="container content-split">
      <div class="content-sticky reveal">
        <p class="eyebrow">El activo como hilo conductor</p>
        <h2>La intervención termina. El conocimiento permanece.</h2>
        <p class="lead">Cuando una OT, una tarea preventiva o una revisión se cierra, el resultado vuelve al activo. Así la próxima persona no empieza desde cero.</p>
        <a class="button button-primary" href={withBase('/ecosistema')}>Ver arquitectura del ecosistema →</a>
      </div>
      <div class="feature-list">
        <article class="feature-row reveal"><span>Antes</span><h3>Contexto técnico disponible</h3><p>Ubicación, documentación, histórico, últimas incidencias y revisiones anteriores.</p></article>
        <article class="feature-row reveal"><span>Durante</span><h3>Trabajo y evidencias</h3><p>Tiempos, actuaciones, fotografías, materiales, mediciones, checklist y observaciones.</p></article>
        <article class="feature-row reveal"><span>Después</span><h3>Histórico reutilizable</h3><p>Resultado, causa, solución, próxima tarea y datos disponibles para mantenimiento futuro.</p></article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container content-split">
      <div class="content-sticky reveal">
        <p class="eyebrow">Tipos de mantenimiento</p>
        <h2>Una misma base para trabajos diferentes</h2>
        <p class="lead">La herramienta debe adaptarse al trabajo técnico, no obligar a que todos los trabajos parezcan iguales.</p>
      </div>
      <div class="feature-list">
        <article class="feature-row reveal"><span>Correctivo</span><h3>Resolver una incidencia con trazabilidad</h3><p>Desde el aviso urgente hasta la reparación, las pruebas finales y el cierre documentado.</p></article>
        <article class="feature-row reveal"><span>Preventivo</span><h3>Planificar antes de que aparezca el fallo</h3><p>Frecuencias, tareas, activos, rutas, responsables, resultados y próxima fecha.</p></article>
        <article class="feature-row reveal"><span>Reglamentario</span><h3>Demostrar qué se revisó y con qué resultado</h3><p>Checklists, mediciones, defectos, evidencias, vigencia documental e informe.</p></article>
        <article class="feature-row reveal"><span>Mejora</span><h3>Convertir observaciones en actuaciones planificadas</h3><p>Hallazgos, riesgos, propuestas, prioridad y seguimiento hasta su ejecución.</p></article>
      </div>
    </div>
  </section>

  <section class="section section-soft">
    <div class="container">
      <div class="section-heading reveal"><p class="eyebrow">Entornos de aplicación</p><h2>Una arquitectura común para instalaciones muy diferentes</h2><p class="lead">IsiVoltPro no se diseña para un único sector. El contexto cambia; la necesidad de trazabilidad permanece.</p></div>
      <div class="sector-detail-grid">
        <article class="reveal"><span>Hospitales</span><h3>Instalaciones críticas y múltiples especialidades</h3><p>Ubicaciones precisas, prioridades, accesos, coordinación, continuidad y documentación técnica.</p></article>
        <article class="reveal"><span>Industria</span><h3>Activos, producción y tiempos de parada</h3><p>Histórico, repuestos, causas, pruebas y conocimiento acumulado por equipo.</p></article>
        <article class="reveal"><span>Edificios</span><h3>Servicios compartidos y mantenimiento integral</h3><p>Electricidad, climatización, fontanería, seguridad, comunicaciones y conservación.</p></article>
        <article class="reveal"><span>Servicios técnicos</span><h3>Oficina y campo trabajando como un solo equipo</h3><p>Clientes, instalaciones, técnicos, agenda, evidencias, firma e informe final.</p></article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="cta reveal">
        <div><p class="eyebrow">Aplicación operativa</p><h2>IsiVoltPro OT ya convierte parte de este modelo en trabajo real</h2><p>Clientes, instalaciones, órdenes, asignación, estados, zona técnico y auditoría cronológica son la primera pieza operativa del mantenimiento conectado.</p></div>
        <div class="hero-actions"><a class="button button-dark" href={withBase('/aplicaciones/mantenimiento-ot')}>Ver IsiVoltPro OT →</a><a class="button button-secondary" href="https://ot.isivoltpro.com/" target="_blank" rel="noopener noreferrer">Abrir aplicación ↗</a></div>
      </div>
    </div>
  </section>
</PageLayout>
