---
import '../styles/portal.css';
import { brand } from '../data/brand';

interface Props {
  title: string;
  description: string;
  section?: string;
  compact?: boolean;
}

const {
  title,
  description,
  section = 'Acceso seguro',
  compact = false,
} = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const withBase = (href: string) => `${base}${href.replace(/^\/+/, '')}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="theme-color" content="#06152c" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>{title} · {brand.name}</title>
  </head>
  <body class:list={['portal-body', compact && 'portal-body--compact']}>
    <a class="portal-skip-link" href="#portal-content">Saltar al contenido</a>
    <header class="portal-topbar">
      <a class="portal-brand" href={withBase('portal/')} aria-label="IsiVoltPro, acceso seguro">
        <span class="portal-brand__mark" aria-hidden="true">IV</span>
        <span>
          <strong>{brand.name}</strong>
          <small>{section}</small>
        </span>
      </a>
      <div class="portal-trust">
        <span class="portal-trust__dot" aria-hidden="true"></span>
        Identidad central · Conexión cifrada
      </div>
    </header>

    <main id="portal-content" class="portal-main">
      <slot />
    </main>

    <footer class="portal-footer">
      <span>© {new Date().getFullYear()} {brand.name}</span>
      <nav aria-label="Información legal">
        <a href={withBase('privacidad/')}>Privacidad</a>
        <a href={withBase('aviso-legal/')}>Aviso legal</a>
        <a href={withBase('contacto/')}>Soporte</a>
      </nav>
    </footer>
  </body>
</html>
