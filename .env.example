# URL pública del gateway Supabase autohospedado.
# Ejemplo: https://api.isivoltpro.com
PUBLIC_SUPABASE_URL=

# Clave pública/anon del proyecto. Es apta para navegador únicamente con RLS activa.
# Nunca colocar aquí SUPABASE_SERVICE_ROLE_KEY ni claves secretas.
PUBLIC_SUPABASE_ANON_KEY=

# URL y base de la compilación Astro.
PUBLIC_SITE_URL=https://app.isivoltpro.com
PUBLIC_BASE_PATH=/
