# El gateway publica Supabase bajo el mismo origen para evitar CORS y
# compartir una política CSP estricta. El navegador añadirá /auth/v1,
# /rest/v1 y /functions/v1 a esta URL.
PUBLIC_SUPABASE_URL=https://app.isivoltpro.com/api

# Clave pública/anon del proyecto. Es apta para navegador únicamente con RLS activa.
# Nunca colocar aquí SUPABASE_SERVICE_ROLE_KEY, JWT secret ni claves SMTP.
PUBLIC_SUPABASE_ANON_KEY=

# URL y base de la compilación Astro.
PUBLIC_SITE_URL=https://app.isivoltpro.com
PUBLIC_BASE_PATH=/
